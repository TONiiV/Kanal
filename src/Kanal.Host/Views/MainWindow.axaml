<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kanal.Host.ViewModels"
        xmlns:views="using:Kanal.Host.Views"
        xmlns:l="using:Kanal.Host.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1320" d:DesignHeight="820"
        x:Class="Kanal.Host.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/kanal.ico"
        Title="Kanal"
        Width="1320" Height="820"
        FontFamily="{StaticResource Sans}"
        TextElement.Foreground="{StaticResource Ink}"
        Background="{StaticResource Sheet}">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- Three declared regions, not a transcript that happens to be what is left over. The centre
         is the only starred column and carries a floor, so no combination of collapse and drag can
         squeeze it to nothing - which is exactly how the prototype failed. -->
    <Grid x:Name="Shell">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding Shell.LeftColumn, Mode=TwoWay}" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*"
                              MinWidth="{x:Static vm:WorkspaceShellViewModel.TranscriptReserve}" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="{Binding Shell.RightColumn, Mode=TwoWay}" />
        </Grid.ColumnDefinitions>

        <views:WorkspaceSidebarView Grid.Column="0" IsVisible="{Binding !Shell.LeftCollapsed}" />
        <GridSplitter Grid.Column="1" x:Name="WorkspaceSplitter" Width="5"
                      ResizeDirection="Columns" Background="Transparent"
                      IsVisible="{Binding !Shell.LeftCollapsed}"
                      ToolTip.Tip="{l:T sidebar.resize.tip}" />

        <DockPanel Grid.Column="2">
            <views:IconBarView DockPanel.Dock="Top" />
            <views:StatusBarView DockPanel.Dock="Bottom" />
            <views:MeetingRoomView />
        </DockPanel>

        <GridSplitter Grid.Column="3" x:Name="AssistantSplitter" Width="5"
                      ResizeDirection="Columns" Background="Transparent"
                      IsVisible="{Binding !Shell.RightCollapsed}"
                      ToolTip.Tip="{l:T sidebar.resize.tip}" />
        <views:SidePanelView Grid.Column="4" IsVisible="{Binding !Shell.RightCollapsed}" />
    </Grid>
</Window>

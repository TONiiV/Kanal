<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kanal.Host.ViewModels"
        xmlns:controls="using:Kanal.Host.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1320" d:DesignHeight="820"
        x:Class="Kanal.Host.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/kanal.ico"
        Title="Kanal"
        Width="1320" Height="820"
        FontFamily="{StaticResource Sans}"
        TextElement.Foreground="{StaticResource Ink}"
        Background="{StaticResource Sheet}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <!-- One utterance = one ruled record. The live one gets weight and air, never a box. -->
        <Style Selector="Border.rec">
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0,9,0,0" />
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>
        <Style Selector="Border.rec.live">
            <Setter Property="BorderThickness" Value="0,3,0,0" />
            <Setter Property="Padding" Value="0,12,0,0" />
            <Setter Property="Margin" Value="0,28,0,20" />
        </Style>
        <Style Selector="Border.rec TextBlock.body">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="LineHeight" Value="24" />
        </Style>
        <Style Selector="Border.rec.live TextBlock.body">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="LineHeight" Value="30" />
        </Style>
        <Style Selector="Border.rec TextBlock.who">
            <Setter Property="FontSize" Value="10.5" />
        </Style>
        <Style Selector="Border.rec.live TextBlock.who">
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <!-- The column head is the grab handle, and a tab stop for the keyboard route. Focus is
             marked with the same rule the drop target uses — this column is the one that moves.
             The negative margin pays for the rule, so the head never shifts against its column. -->
        <Style Selector="Border.colhead:focus">
            <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="Padding" Value="6,0,0,0" />
            <Setter Property="Margin" Value="-9,0,0,16" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- masthead -->
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,2" Padding="24,14,24,12">
            <StackPanel Spacing="14">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Text="KANAL" FontSize="15" FontWeight="Bold"
                               LetterSpacing="3.4" VerticalAlignment="Center" />
                    <!-- What this machine is actually wired to, in the operator's line of sight
                         before Start — both stages, in pipeline order, on one rule. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                VerticalAlignment="Center" HorizontalAlignment="Right"
                                Margin="0,0,20,0">
                        <TextBlock Text="{Binding TranscriptionStatus}" FontSize="11"
                                   Foreground="{StaticResource Ink3}" VerticalAlignment="Center" />
                        <Rectangle Width="1" Height="11" Fill="{StaticResource Rule}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TranslationStatus}" FontSize="11"
                                   Foreground="{StaticResource Ink3}" VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- Transport, then a rule, then the things that are not transport. The icons
                         carry the shape at a glance from a metre; the words carry which of the
                         three it is, since ▶ and ❚❚ differ by very little at that distance. -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding StartCommand}" Classes="accent">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <Path Classes="glyph" Data="{StaticResource GlyphPlay}"
                                      Width="10" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                                <TextBlock Text="Start" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- One button, both directions: mid-meeting the operator should not have
                             to find a second control to undo the first. -->
                        <Button Command="{Binding PauseCommand}"
                                ToolTip.Tip="Take the room off the record — nothing transcribed, translated or sent. The room, the QR and the transcript all stay.">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <Path Classes="glyph" Data="{StaticResource GlyphPause}"
                                      Width="10" Height="12" Stretch="Uniform" VerticalAlignment="Center"
                                      IsVisible="{Binding !IsPaused}" />
                                <Path Classes="glyph" Data="{StaticResource GlyphPlay}"
                                      Width="10" Height="12" Stretch="Uniform" VerticalAlignment="Center"
                                      IsVisible="{Binding IsPaused}" />
                                <TextBlock Text="{Binding PauseLabel}" VerticalAlignment="Center" Width="50" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding StopCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <Path Classes="glyph" Data="{StaticResource GlyphStop}"
                                      Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" />
                                <TextBlock Text="Stop" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Rectangle Width="1" Height="20" Fill="{StaticResource Rule}"
                                   VerticalAlignment="Center" Margin="4,0" />

                        <Button Content="Export .md" Command="{Binding ExportMarkdownCommand}" Classes="ghost" />
                        <Button Click="OnSettingsClick" Classes="ghost" Padding="8,6"
                                ToolTip.Tip="Settings" AutomationProperties.Name="Settings">
                            <Path Classes="glyph" Data="{StaticResource GlyphSettings}"
                                  Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>

                <WrapPanel ItemSpacing="22" LineSpacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                        <TextBlock Text="MODE" Classes="label" />
                        <!-- The mode names the pipeline, never the vendor, and each row carries
                             what it sends off this machine. Rows that cannot run stay in the
                             list, disabled, with the blocker printed beside them — hiding them
                             hides the roadmap, and failing at Start is worse than both. -->
                        <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}"
                                  Width="352" IsEnabled="{Binding !IsRunning}" VerticalAlignment="Center">
                            <ComboBox.ItemContainerTheme>
                                <ControlTheme TargetType="ComboBoxItem"
                                              x:DataType="vm:PipelineModeOption"
                                              BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                    <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                                </ControlTheme>
                            </ComboBox.ItemContainerTheme>
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PipelineModeOption">
                                    <StackPanel Spacing="2" Margin="0,2,0,3">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" />
                                        <TextBlock Text="{Binding Detail}" FontSize="10.5"
                                                   LineHeight="15" TextWrapping="Wrap" MaxWidth="316"
                                                   Foreground="{StaticResource Ink3}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                        <TextBlock Text="LANGUAGES" Classes="label" />
                        <!-- selected languages as an overlapping stack of flag discs; codes are
                             always printed next to it — colour never carries meaning alone -->
                        <Button Classes="ghost" Padding="5,3" Click="OnLanguagesClick"
                                IsEnabled="{Binding !IsRunning}"
                                ToolTip.Tip="Room languages — click to edit">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ItemsControl ItemsSource="{Binding SelectedLanguages}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="-8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LanguageOption">
                                            <Border Background="{StaticResource Sheet}" CornerRadius="13" Padding="2">
                                                <controls:FlagIcon Code="{Binding Code}" Width="22" Height="22" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding SelectedLanguageSummary}" FontSize="12"
                                           Foreground="{StaticResource Ink2}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center"
                                IsVisible="{Binding NeedsMicrophone}">
                        <TextBlock Text="INPUT" Classes="label" />
                        <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" Width="220"
                                  IsEnabled="{Binding !IsRunning}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Paused has to be unmissable from a metre. Columns that have simply stopped look
             exactly like a room where nobody is talking, and "am I being recorded" is the one
             question that must never be answered by inference. Inverted ink — the heaviest
             statement available without spending colour, which belongs to speakers. -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding IsPaused}"
                Background="{StaticResource Ink}" Padding="24,10">
            <StackPanel Orientation="Horizontal" Spacing="13">
                <Path Data="{StaticResource GlyphPause}" Fill="{StaticResource Sheet}"
                      Width="9" Height="11" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Text="PAUSED — NOTHING IS BEING TRANSCRIBED, TRANSLATED OR SENT"
                           FontSize="11.5" FontWeight="Bold" LetterSpacing="1.7"
                           Foreground="{StaticResource Sheet}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- status line -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" Padding="24,8">
            <DockPanel>
                <!-- input level: the first thing to look at when "nothing is happening" -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                            IsVisible="{Binding ShowMicLevel}" VerticalAlignment="Center">
                    <TextBlock Text="INPUT" Classes="label" />
                    <ProgressBar Value="{Binding MicLevel}" Maximum="100" Width="120" Height="6"
                                 Foreground="{StaticResource Ink}" Background="{StaticResource RuleFaint}"
                                 CornerRadius="0" />
                </StackPanel>
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource Ink2}" FontSize="12" />
            </DockPanel>
        </Border>

        <!-- join + speakers -->
        <Border DockPanel.Dock="Right" Width="272" BorderBrush="{StaticResource Rule}" BorderThickness="1,0,0,0"
                Padding="20,20,20,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" IsVisible="{Binding HasJoinInfo}" Margin="0,0,0,22">
                    <TextBlock Text="JOIN" Classes="label" />
                    <Border BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,1" Margin="0,6,0,12" />
                    <Image Source="{Binding QrImage}" Width="196" Height="196" HorizontalAlignment="Left"
                           RenderOptions.BitmapInterpolationMode="None" />
                    <TextBox Text="{Binding JoinUrl}" IsReadOnly="True" FontSize="10" Height="48"
                             TextWrapping="Wrap" AcceptsReturn="True" Margin="0,10,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                    <TextBlock Text="MERGE" Classes="label" />
                    <Border BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,1" Margin="0,6,0,10" />
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBox Text="{Binding MergeFromTag}" PlaceholderText="S03" Width="58" />
                        <TextBlock Text="→" VerticalAlignment="Center" Foreground="{StaticResource Ink3}" />
                        <TextBox Text="{Binding MergeIntoTag}" PlaceholderText="S01" Width="58" />
                        <Button Content="Merge" Command="{Binding MergeSpeakersCommand}" />
                    </StackPanel>
                </StackPanel>

                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="SPEAKERS" Classes="label" />
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,1"
                            Margin="0,6,0,12" />
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Speakers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SpeakerItemViewModel">
                                    <Grid ColumnDefinitions="3,*,Auto" Margin="0,0,0,14">
                                        <Rectangle Grid.Column="0" Width="3" Fill="{Binding Color}"
                                                   VerticalAlignment="Stretch" />
                                        <StackPanel Grid.Column="1" Margin="11,0,0,0" Spacing="5">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <TextBlock Text="{Binding Tag}" FontSize="10.5" FontWeight="Bold"
                                                           LetterSpacing="1.2" Foreground="{Binding Color}" />
                                                <TextBlock Text="{Binding MergedFromLabel}" FontSize="10.5"
                                                           Foreground="{StaticResource Ink3}" />
                                            </StackPanel>
                                            <TextBox Text="{Binding Name}" PlaceholderText="display name">
                                                <TextBox.KeyBindings>
                                                    <KeyBinding Gesture="Enter" Command="{Binding RenameCommand}" />
                                                </TextBox.KeyBindings>
                                            </TextBox>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="✓" Classes="ghost" Padding="10,5"
                                                VerticalAlignment="Bottom" Command="{Binding RenameCommand}"
                                                ToolTip.Tip="Apply name (or press Enter)" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- fills whatever the docked panels leave: the empty state, then the columns over it -->
        <Panel>
        <!-- before the first Start: what the columns will be, not an empty grey field -->
        <StackPanel IsVisible="{Binding !HasColumns}" Margin="24,30,24,10" MaxWidth="440"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Spacing="14">
            <TextBlock Text="NO ROOM YET" Classes="label" />
            <Border BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,2" />
            <TextBlock TextWrapping="Wrap" FontSize="14.5" LineHeight="25" Foreground="{StaticResource Ink2}"
                       Text="Pick the languages spoken in the room, then Start. One column per language, newest utterance at the bottom." />
            <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="21" Foreground="{StaticResource Ink3}"
                       Text="The mode picks both stages — where speech is transcribed and where it is translated — and says what leaves this machine. Demo needs no key. A join QR appears on the right; everyone else reads on their own phone, in their own language." />
        </StackPanel>

        <!-- language columns -->
        <ItemsControl ItemsSource="{Binding Columns}" Margin="24,22,0,10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ColumnViewModel">
                  <!-- The drop rules overlay the gutters rather than sitting in the layout, so
                       marking a target never reflows the text under the operator's eye. -->
                  <Panel Margin="0,0,30,0" DragDrop.AllowDrop="True"
                         DragDrop.DragOver="OnColumnDragOver"
                         DragDrop.DragLeave="OnColumnDragLeave"
                         DragDrop.Drop="OnColumnDrop">
                    <DockPanel>
                        <!-- grab handle: drag the head to move the column, or Alt+←/→ once focused -->
                        <Border DockPanel.Dock="Top" Classes="colhead" Margin="0,0,0,16"
                                Background="Transparent" Focusable="True" Cursor="SizeWestEast"
                                ToolTip.Tip="Drag to move this column — or Alt+← / Alt+→"
                                PointerPressed="OnColumnHeadPointerPressed"
                                KeyDown="OnColumnHeadKeyDown">
                          <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <TextBlock Text="{Binding Code}" FontSize="21" FontWeight="Bold" LetterSpacing="0.5" />
                                <TextBlock Text="{Binding NativeName}" FontSize="12.5" Margin="0,0,0,3"
                                           Foreground="{StaticResource Ink3}" VerticalAlignment="Bottom" />
                            </StackPanel>
                            <Border BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,2" Margin="0,7,0,0" />
                          </StackPanel>
                        </Border>
                        <ScrollViewer Loaded="OnColumnScrollLoaded" DetachedFromVisualTree="OnColumnScrollDetached">
                            <ItemsControl ItemsSource="{Binding Bubbles}" Margin="0,0,14,40">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BubbleViewModel">
                                        <Border Classes="rec" Classes.live="{Binding IsLive}"
                                                BorderBrush="{Binding RuleColor}">
                                            <StackPanel Spacing="5">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Classes="who" Text="{Binding SpeakerName}"
                                                               FontWeight="Bold" LetterSpacing="1.2"
                                                               Foreground="{Binding SpeakerColor}" />
                                                    <TextBlock Classes="who" Text="{Binding SourceLang}"
                                                               LetterSpacing="1.5"
                                                               Foreground="{StaticResource Ink3}" />
                                                    <TextBlock Classes="who" Text="· ORIGINAL" LetterSpacing="1.5"
                                                               IsVisible="{Binding IsTranscript}"
                                                               ToolTip.Tip="Spoken in this language — transcript, not a translation"
                                                               Foreground="{StaticResource Ink3}" />
                                                    <TextBlock Classes="who" Text="⇄" ToolTip.Tip="Mixed language"
                                                               IsVisible="{Binding CodeSwitch}"
                                                               Foreground="{StaticResource Ink3}" />
                                                </StackPanel>
                                                <TextBlock Classes="body" Text="{Binding Text}" TextWrapping="Wrap"
                                                           Foreground="{Binding TextColor}" />
                                                <Border IsVisible="{Binding HasSource}" Margin="0,4,0,0"
                                                        BorderBrush="{StaticResource RuleFaint}"
                                                        BorderThickness="1,0,0,0" Padding="11,0,0,0">
                                                    <TextBlock Text="{Binding SourceText}" TextWrapping="Wrap"
                                                               FontSize="12" LineHeight="20"
                                                               Foreground="{StaticResource Ink3}" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- where the dragged column will land: the heaviest rule in the vocabulary,
                         standing in the gutter it would be inserted into -->
                    <Rectangle Width="3" HorizontalAlignment="Left" Margin="-16,0,0,0"
                               Fill="{StaticResource Ink}" IsVisible="{Binding IsDropBefore}" />
                    <Rectangle Width="3" HorizontalAlignment="Right" Margin="0,0,-16,0"
                               Fill="{StaticResource Ink}" IsVisible="{Binding IsDropAfter}" />
                  </Panel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </Panel>
    </DockPanel>
</Window>

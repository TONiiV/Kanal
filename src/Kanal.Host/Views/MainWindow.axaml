<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kanal.Host.ViewModels"
        xmlns:views="using:Kanal.Host.Views"
        xmlns:l="using:Kanal.Host.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1320" d:DesignHeight="820"
        x:Class="Kanal.Host.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/kanal.ico"
        Title="Kanal"
        Width="1320" Height="820"
        MinWidth="{x:Static vm:WorkspaceShellViewModel.MinShellWidth}"
        FontFamily="{StaticResource Sans}"
        TextElement.Foreground="{StaticResource Ink}"
        Background="{StaticResource Sheet}">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- The centre is the only starred column and carries a floor: a transcript that is merely
         what the sidebars leave over is how the prototype collapsed. -->
    <Grid x:Name="Shell">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding Shell.Left.Column, Mode=TwoWay}"
                              MinWidth="{Binding Shell.Left.ColumnMinWidth}"
                              MaxWidth="{Binding Shell.Left.ColumnMaxWidth}" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*"
                              MinWidth="{x:Static vm:WorkspaceShellViewModel.TranscriptReserve}" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="{Binding Shell.Right.Column, Mode=TwoWay}"
                              MinWidth="{Binding Shell.Right.ColumnMinWidth}"
                              MaxWidth="{Binding Shell.Right.ColumnMaxWidth}" />
        </Grid.ColumnDefinitions>

        <views:WorkspaceSidebarView Grid.Column="0" IsVisible="{Binding !Shell.Left.Collapsed}" />
        <GridSplitter Grid.Column="1" x:Name="WorkspaceSplitter"
                      Width="{x:Static vm:SidebarViewModel.SplitterWidth}"
                      ResizeDirection="Columns" Background="Transparent"
                      IsVisible="{Binding !Shell.Left.Collapsed}"
                      ToolTip.Tip="{l:T sidebar.resize.tip}" />

        <DockPanel Grid.Column="2">
            <views:IconBarView DockPanel.Dock="Top" />
            <views:StatusBarView DockPanel.Dock="Bottom" />
            <views:MeetingRoomView />
        </DockPanel>

        <GridSplitter Grid.Column="3" x:Name="AssistantSplitter"
                      Width="{x:Static vm:SidebarViewModel.SplitterWidth}"
                      ResizeDirection="Columns" Background="Transparent"
                      IsVisible="{Binding !Shell.Right.Collapsed}"
                      ToolTip.Tip="{l:T sidebar.resize.tip}" />
        <views:SidePanelView Grid.Column="4" IsVisible="{Binding !Shell.Right.Collapsed}" />
    </Grid>
</Window>

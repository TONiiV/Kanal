<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kanal.Host.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1320" d:DesignHeight="820"
        x:Class="Kanal.Host.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Kanal"
        Width="1320" Height="820"
        FontFamily="{StaticResource Sans}"
        TextElement.Foreground="{StaticResource Ink}"
        Background="{StaticResource Sheet}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <!-- One utterance = one ruled record. The live one gets weight and air, never a box. -->
        <Style Selector="Border.rec">
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0,9,0,0" />
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>
        <Style Selector="Border.rec.live">
            <Setter Property="BorderThickness" Value="0,3,0,0" />
            <Setter Property="Padding" Value="0,12,0,0" />
            <Setter Property="Margin" Value="0,28,0,20" />
        </Style>
        <Style Selector="Border.rec TextBlock.body">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="LineHeight" Value="24" />
        </Style>
        <Style Selector="Border.rec.live TextBlock.body">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="LineHeight" Value="30" />
        </Style>
        <Style Selector="Border.rec TextBlock.who">
            <Setter Property="FontSize" Value="10.5" />
        </Style>
        <Style Selector="Border.rec.live TextBlock.who">
            <Setter Property="FontSize" Value="11.5" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- masthead -->
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,2" Padding="24,14,24,12">
            <StackPanel Spacing="14">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Text="KANAL" FontSize="15" FontWeight="Bold"
                               LetterSpacing="3.4" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding KeyStatus}" FontSize="11"
                               Foreground="{StaticResource Ink3}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Margin="0,0,20,0" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button Content="Start" Command="{Binding StartCommand}" Classes="accent" />
                        <Button Content="Stop" Command="{Binding StopCommand}" />
                        <Button Content="Export .md" Command="{Binding ExportMarkdownCommand}" Classes="ghost" />
                        <Button Content="Settings" Click="OnSettingsClick" Classes="ghost" />
                    </StackPanel>
                </Grid>

                <WrapPanel ItemSpacing="22" LineSpacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                        <TextBlock Text="MODE" Classes="label" />
                        <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" Width="152"
                                  IsEnabled="{Binding !IsRunning}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                        <TextBlock Text="LANGUAGES" Classes="label" />
                        <ItemsControl ItemsSource="{Binding LanguageOptions}" IsEnabled="{Binding !IsRunning}"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="-1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LanguageOption">
                                    <ToggleButton IsChecked="{Binding IsSelected}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Code}" FontWeight="Bold" LetterSpacing="1" />
                                            <TextBlock Text="{Binding Label}" Opacity="0.7" />
                                        </StackPanel>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox Text="{Binding ExtraLanguagesInput}" Width="86" PlaceholderText="+ fr, es"
                                 ToolTip.Tip="Extra ISO codes, comma separated"
                                 IsEnabled="{Binding !IsRunning}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center"
                                IsVisible="{Binding IsGladiaMode}">
                        <TextBlock Text="INPUT" Classes="label" />
                        <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" Width="220"
                                  IsEnabled="{Binding !IsRunning}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- status line -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" Padding="24,8">
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource Ink2}" FontSize="12" />
        </Border>

        <!-- join + speakers -->
        <Border DockPanel.Dock="Right" Width="272" BorderBrush="{StaticResource Rule}" BorderThickness="1,0,0,0"
                Padding="20,20,20,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" IsVisible="{Binding HasJoinInfo}" Margin="0,0,0,22">
                    <TextBlock Text="JOIN" Classes="label" />
                    <Border BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,1" Margin="0,6,0,12" />
                    <Image Source="{Binding QrImage}" Width="196" Height="196" HorizontalAlignment="Left"
                           RenderOptions.BitmapInterpolationMode="None" />
                    <TextBox Text="{Binding JoinUrl}" IsReadOnly="True" FontSize="10" Height="48"
                             TextWrapping="Wrap" AcceptsReturn="True" Margin="0,10,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                    <TextBlock Text="MERGE" Classes="label" />
                    <Border BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,1" Margin="0,6,0,10" />
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBox Text="{Binding MergeFromTag}" PlaceholderText="S03" Width="58" />
                        <TextBlock Text="→" VerticalAlignment="Center" Foreground="{StaticResource Ink3}" />
                        <TextBox Text="{Binding MergeIntoTag}" PlaceholderText="S01" Width="58" />
                        <Button Content="Merge" Command="{Binding MergeSpeakersCommand}" />
                    </StackPanel>
                </StackPanel>

                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="SPEAKERS" Classes="label" />
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,1"
                            Margin="0,6,0,12" />
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Speakers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SpeakerItemViewModel">
                                    <Grid ColumnDefinitions="3,*,Auto" Margin="0,0,0,14">
                                        <Rectangle Grid.Column="0" Width="3" Fill="{Binding Color}"
                                                   VerticalAlignment="Stretch" />
                                        <StackPanel Grid.Column="1" Margin="11,0,0,0" Spacing="5">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <TextBlock Text="{Binding Tag}" FontSize="10.5" FontWeight="Bold"
                                                           LetterSpacing="1.2" Foreground="{Binding Color}" />
                                                <TextBlock Text="{Binding MergedFromLabel}" FontSize="10.5"
                                                           Foreground="{StaticResource Ink3}" />
                                            </StackPanel>
                                            <TextBox Text="{Binding Name}" PlaceholderText="display name">
                                                <TextBox.KeyBindings>
                                                    <KeyBinding Gesture="Enter" Command="{Binding RenameCommand}" />
                                                </TextBox.KeyBindings>
                                            </TextBox>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="✓" Classes="ghost" Padding="10,5"
                                                VerticalAlignment="Bottom" Command="{Binding RenameCommand}"
                                                ToolTip.Tip="Apply name (or press Enter)" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- fills whatever the docked panels leave: the empty state, then the columns over it -->
        <Panel>
        <!-- before the first Start: what the columns will be, not an empty grey field -->
        <StackPanel IsVisible="{Binding !HasColumns}" Margin="24,30,24,10" MaxWidth="440"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Spacing="14">
            <TextBlock Text="NO ROOM YET" Classes="label" />
            <Border BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,2" />
            <TextBlock TextWrapping="Wrap" FontSize="14.5" LineHeight="25" Foreground="{StaticResource Ink2}"
                       Text="Pick the languages spoken in the room, then Start. One column per language, newest utterance at the bottom." />
            <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="21" Foreground="{StaticResource Ink3}"
                       Text="Demo (scripted) runs without an API key. Gladia (live) streams the selected input device. A join QR appears on the right — everyone else reads on their own phone, in their own language." />
        </StackPanel>

        <!-- language columns -->
        <ItemsControl ItemsSource="{Binding Columns}" Margin="24,22,0,10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ColumnViewModel">
                    <DockPanel Margin="0,0,30,0">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <TextBlock Text="{Binding Code}" FontSize="21" FontWeight="Bold" LetterSpacing="0.5" />
                                <TextBlock Text="{Binding NativeName}" FontSize="12.5" Margin="0,0,0,3"
                                           Foreground="{StaticResource Ink3}" VerticalAlignment="Bottom" />
                            </StackPanel>
                            <Border BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,2" Margin="0,7,0,0" />
                        </StackPanel>
                        <ScrollViewer Loaded="OnColumnScrollLoaded" DetachedFromVisualTree="OnColumnScrollDetached">
                            <ItemsControl ItemsSource="{Binding Bubbles}" Margin="0,0,14,40">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BubbleViewModel">
                                        <Border Classes="rec" Classes.live="{Binding IsLive}"
                                                BorderBrush="{Binding RuleColor}">
                                            <StackPanel Spacing="5">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Classes="who" Text="{Binding SpeakerName}"
                                                               FontWeight="Bold" LetterSpacing="1.2"
                                                               Foreground="{Binding SpeakerColor}" />
                                                    <TextBlock Classes="who" Text="{Binding SourceLang}"
                                                               LetterSpacing="1.5"
                                                               Foreground="{StaticResource Ink3}" />
                                                    <TextBlock Classes="who" Text="⇄" ToolTip.Tip="Mixed language"
                                                               IsVisible="{Binding CodeSwitch}"
                                                               Foreground="{StaticResource Ink3}" />
                                                </StackPanel>
                                                <TextBlock Classes="body" Text="{Binding Text}" TextWrapping="Wrap"
                                                           Foreground="{Binding TextColor}" />
                                                <Border IsVisible="{Binding HasSource}" Margin="0,4,0,0"
                                                        BorderBrush="{StaticResource RuleFaint}"
                                                        BorderThickness="1,0,0,0" Padding="11,0,0,0">
                                                    <TextBlock Text="{Binding SourceText}" TextWrapping="Wrap"
                                                               FontSize="12" LineHeight="20"
                                                               Foreground="{StaticResource Ink3}" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </Panel>
    </DockPanel>
</Window>

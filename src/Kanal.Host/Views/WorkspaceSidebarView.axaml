<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kanal.Host.ViewModels"
             xmlns:l="using:Kanal.Host.Localization"
             x:Class="Kanal.Host.Views.WorkspaceSidebarView" x:DataType="vm:MainViewModel">
    <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,0,1,0">
        <DockPanel LastChildFill="False">
            <Border DockPanel.Dock="Top" Classes="sidebar-header"
                    MinHeight="{Binding Shell.HeaderHeight}">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Classes="label" x:Name="WorkspaceTitle"
                               Text="{l:T sidebar.workspace}" />
                    <Button DockPanel.Dock="Right" Classes="ghost chevron" x:Name="CollapseWorkspace"
                            Command="{Binding Shell.Left.ToggleCommand}"
                            ToolTip.Tip="{l:T sidebar.collapse.tip}"
                            AutomationProperties.Name="{l:T sidebar.collapse.tip}">
                        <Path Classes="glyph" Data="{StaticResource GlyphChevronLeft}" />
                    </Button>
                </DockPanel>
            </Border>
        </DockPanel>
    </Border>
</UserControl>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Kanal.Host.Localization"
        x:Class="Kanal.Host.Views.RemoveProjectWindow"
        Title="{l:T workspace.remove.title}"
        Width="480" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource Sans}"
        TextElement.Foreground="{StaticResource Ink}"
        Background="{StaticResource Sheet}">

    <StackPanel Margin="26,20,26,18" Spacing="0">
        <TextBlock Text="{l:T workspace.remove.title}" Classes="label" />
        <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" Margin="0,7,0,0" />

        <TextBlock x:Name="Heading" Margin="0,16,0,0" FontSize="15.5" LineHeight="23"
                   TextWrapping="Wrap" />

        <TextBlock Margin="0,12,0,0" FontSize="12.5" FontWeight="SemiBold"
                   Text="{l:T workspace.remove.listonly}" />
        <TextBlock Margin="0,3,0,0" FontSize="12.5" LineHeight="20" TextWrapping="Wrap"
                   Foreground="{StaticResource Ink2}" Text="{l:T workspace.remove.listonly.body}" />

        <TextBlock Margin="0,12,0,0" FontSize="12.5" FontWeight="SemiBold"
                   Foreground="{StaticResource Alarm}" Text="{l:T workspace.remove.deletefiles}" />
        <TextBlock Margin="0,3,0,0" FontSize="12.5" LineHeight="20" TextWrapping="Wrap"
                   Foreground="{StaticResource Ink2}" Text="{l:T workspace.remove.deletefiles.body}" />

        <WrapPanel HorizontalAlignment="Right" Margin="0,20,0,0" ItemSpacing="8" LineSpacing="8">
            <!-- The filled button keeps the project. Neither removal is the button Enter presses. -->
            <Button x:Name="DeleteFiles" Classes="danger" Content="{l:T workspace.remove.deletefiles}"
                    Click="OnDeleteFilesClick" />
            <Button x:Name="ListOnly" Content="{l:T workspace.remove.listonly}" Click="OnListOnlyClick" />
            <Button x:Name="Keep" Classes="accent" Content="{l:T workspace.remove.cancel}"
                    IsDefault="True" IsCancel="True" Click="OnKeepClick" />
        </WrapPanel>
    </StackPanel>
</Window>

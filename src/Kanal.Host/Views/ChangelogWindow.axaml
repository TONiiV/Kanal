<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kanal.Host.ViewModels"
        xmlns:l="using:Kanal.Host.Localization"
        x:Class="Kanal.Host.Views.ChangelogWindow"
        x:DataType="vm:ChangelogViewModel"
        Title="{l:T changelog.title}"
        Width="560" Height="600"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource Sans}"
        TextElement.Foreground="{StaticResource Ink}"
        Background="{StaticResource Sheet}">

    <DockPanel Margin="26,20,26,18">
        <Button DockPanel.Dock="Bottom" Content="{l:T changelog.close}"
                HorizontalAlignment="Right" Margin="0,16,0,0" Click="OnCloseClick" />

        <TextBlock DockPanel.Dock="Top" Text="{Binding CurrentVersion}" Classes="label" />
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,2"
                Margin="0,7,0,0" />

        <TextBlock DockPanel.Dock="Top" Text="{l:T changelog.empty}" IsVisible="{Binding IsEmpty}"
                   FontSize="12.5" Foreground="{StaticResource Ink3}" Margin="0,14,0,0" />

        <ScrollViewer AllowAutoHide="False">
            <ItemsControl ItemsSource="{Binding Entries}" Margin="0,0,14,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChangelogEntryViewModel">
                        <StackPanel Margin="0,20,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding Version}" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Date}" FontSize="12"
                                           Foreground="{StaticResource Ink3}" VerticalAlignment="Bottom"
                                           Margin="0,0,0,2" />
                            </StackPanel>
                            <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1"
                                    Margin="0,7,0,8" />

                            <ItemsControl ItemsSource="{Binding Changes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid ColumnDefinitions="14,*" Margin="0,0,0,6">
                                            <TextBlock Grid.Column="0" Text="—" FontSize="12.5"
                                                       Foreground="{StaticResource Ink3}" />
                                            <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12.5"
                                                       TextWrapping="Wrap" LineHeight="19"
                                                       Foreground="{StaticResource Ink2}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Kanal.Host.Views.SplashWindow"
        Icon="/Assets/kanal.ico"
        Title="Kanal"
        Width="560" Height="460"
        CanResize="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Sans}"
        TextElement.Foreground="{DynamicResource Ink}"
        Background="{DynamicResource Paper}">

    <StackPanel Margin="56,42,56,44" HorizontalAlignment="Center"
                VerticalAlignment="Center" Spacing="10">
        <Image Source="/Assets/kanal-splash-mark.png" Width="200" Height="200"
               Stretch="Uniform" HorizontalAlignment="Center"
               AutomationProperties.Name="Kanal mark" />

        <TextBlock Text="kanal" FontSize="48" FontWeight="Bold"
                   LetterSpacing="-0.8" HorizontalAlignment="Center" />

        <Border Width="48" Height="4" CornerRadius="2" Background="{DynamicResource BrandAccent}" Margin="0,6" />

        <TextBlock Text="One room. Every language." FontSize="16"
                   FontWeight="SemiBold" LetterSpacing="0.35"
                   Foreground="{DynamicResource Ink2}"
                   HorizontalAlignment="Center" />
    </StackPanel>
</Window>

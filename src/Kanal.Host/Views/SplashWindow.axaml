<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Kanal.Host.Views.SplashWindow"
        Icon="/Assets/kanal.ico"
        Title="Kanal"
        Width="560" Height="460"
        CanResize="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Sans}"
        TextElement.Foreground="{StaticResource Ink}"
        Background="{StaticResource Sheet}">

    <StackPanel Margin="56,42,56,44" HorizontalAlignment="Center"
                VerticalAlignment="Center" Spacing="10">
        <Image Source="/Assets/kanal.ico" Width="250" Height="170"
               Stretch="Uniform" HorizontalAlignment="Center"
               AutomationProperties.Name="Kanal mark" />

        <TextBlock Text="kanal" FontSize="68" FontWeight="Bold"
                   LetterSpacing="-1.5" HorizontalAlignment="Center" />

        <Border Width="360" BorderBrush="{StaticResource Ink}"
                BorderThickness="0,2,0,0" Margin="0,2,0,2" />

        <TextBlock Text="One room. Every language." FontSize="18"
                   FontWeight="SemiBold" LetterSpacing="0.35"
                   Foreground="{StaticResource Ink2}"
                   HorizontalAlignment="Center" />
    </StackPanel>
</Window>

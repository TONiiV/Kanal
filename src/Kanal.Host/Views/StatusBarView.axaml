<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kanal.Host.ViewModels"
             xmlns:l="using:Kanal.Host.Localization"
             x:Class="Kanal.Host.Views.StatusBarView" x:DataType="vm:MainViewModel">
    <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" Padding="24,8">
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                        IsVisible="{Binding ShowMicLevel}" VerticalAlignment="Center">
                <TextBlock Text="{l:T input.label}" Classes="label" />
                <ProgressBar Value="{Binding MicLevel}" Maximum="100" Width="120" Height="6"
                             Foreground="{StaticResource Ink}" Background="{StaticResource RuleFaint}"
                             CornerRadius="0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="7"
                        Margin="0,0,22,0" VerticalAlignment="Center"
                        IsVisible="{Binding IsRecording}" ToolTip.Tip="{Binding RecordingPath}">
                <Path Data="{StaticResource GlyphStop}" Width="7" Height="7" Stretch="Uniform"
                      VerticalAlignment="Center" Fill="{StaticResource Ink}" IsVisible="{Binding !IsPaused}" />
                <Path Data="{StaticResource GlyphSquareHollow}" Width="7" Height="7" Stretch="Uniform"
                      VerticalAlignment="Center" Fill="{StaticResource Ink3}" IsVisible="{Binding IsPaused}" />
                <TextBlock Text="{l:T recording.on}" Classes="label" IsVisible="{Binding !IsPaused}" />
                <TextBlock Text="{l:T recording.held}" Classes="label" IsVisible="{Binding IsPaused}" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource Ink2}" FontSize="12" />
        </DockPanel>
    </Border>
</UserControl>

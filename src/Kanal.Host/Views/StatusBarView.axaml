<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Kanal.Host.Controls"
             xmlns:vm="using:Kanal.Host.ViewModels"
             xmlns:l="using:Kanal.Host.Localization"
             x:Class="Kanal.Host.Views.StatusBarView" x:DataType="vm:MainViewModel">
    <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" Padding="28,0" Height="34">
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                        IsVisible="{Binding ShowMicLevel}" VerticalAlignment="Center">
                <TextBlock Text="{l:T input.label}" Classes="label" />
                <ProgressBar Value="{Binding MicLevel}" Maximum="100" Width="64" MinWidth="0" Height="3"
                             Foreground="{StaticResource Brand}" Background="{StaticResource RuleFaint}"
                             CornerRadius="0" AutomationProperties.Name="{l:T input.label}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="0,0,22,0"
                        IsVisible="{Binding ShowComputerLevel}" VerticalAlignment="Center">
                <TextBlock Text="{l:T computer.label}" Classes="label" />
                <ProgressBar Value="{Binding ComputerLevel}" Maximum="100" Width="64" MinWidth="0" Height="3"
                             Foreground="{StaticResource Brand}" Background="{StaticResource RuleFaint}"
                             CornerRadius="0" AutomationProperties.Name="{l:T computer.label}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="7"
                        Margin="0,0,22,0" VerticalAlignment="Center"
                        IsVisible="{Binding IsRecording}" ToolTip.Tip="{Binding RecordingPath}">
                <Path Data="{c:Icon stop}" Width="10" Height="10" Stretch="Uniform"
                      VerticalAlignment="Center" Fill="{StaticResource Ink}" IsVisible="{Binding !IsPaused}" />
                <Path Data="{c:Icon square-hollow}" Width="10" Height="10" Stretch="Uniform"
                      VerticalAlignment="Center" Fill="{StaticResource Ink3}" IsVisible="{Binding IsPaused}" />
                <TextBlock Text="{l:T recording.on}" Classes="label" IsVisible="{Binding !IsPaused}" />
                <TextBlock Text="{l:T recording.held}" Classes="label" IsVisible="{Binding IsPaused}" />
            </StackPanel>
            <StackPanel Margin="0,0,22,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource Ink2}" FontSize="11"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding AudioSourceStatus}" Foreground="{StaticResource Ink}" FontSize="11"
                           TextTrimming="CharacterEllipsis" IsVisible="{Binding ShowAudioHintInStatusBar}" />
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>

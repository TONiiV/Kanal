<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kanal.Host.ViewModels"
        x:Class="Kanal.Host.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Kanal — Settings"
        Width="560" Height="420"
        WindowStartupLocation="CenterOwner"
        Background="#E9EDF0">

    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="Gladia API keys" FontWeight="Bold" FontSize="16" Margin="0,0,0,4" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding EnvFallback}" FontSize="12" Foreground="#7A8791" Margin="0,0,0,10" />

        <!-- add row -->
        <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#C6D0D7" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBox Text="{Binding NewName}" PlaceholderText="name (e.g. work)" Width="140" />
                <TextBox Text="{Binding NewKey}" PlaceholderText="API key" PasswordChar="•" Width="230" />
                <Button Content="Add" Command="{Binding AddCommand}" />
            </StackPanel>
        </Border>

        <Button DockPanel.Dock="Bottom" Content="Save &amp; Close" Click="OnSaveClick"
                HorizontalAlignment="Right" Margin="0,10,0,0" Classes="accent" />

        <!-- key list -->
        <Border Background="#FFFFFF" BorderBrush="#C6D0D7" BorderThickness="1" CornerRadius="4" Padding="6">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Keys}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ApiKeyItemViewModel">
                            <Grid ColumnDefinitions="Auto,140,*,Auto" Margin="4">
                                <RadioButton Grid.Column="0" GroupName="activeKey" IsChecked="{Binding IsActive}"
                                             VerticalAlignment="Center" ToolTip.Tip="Use this key" />
                                <TextBox Grid.Column="1" Text="{Binding Name}" Margin="4,0" />
                                <TextBox Grid.Column="2" Text="{Binding Key}" PasswordChar="•" Margin="4,0" />
                                <Button Grid.Column="3" Content="✕" Padding="8,4"
                                        Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).RemoveCommand}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Kanal.Host.Localization"
        x:Class="Kanal.Host.Views.DeleteMeetingWindow"
        Title="{l:T meeting.delete.title}"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource Sans}"
        TextElement.Foreground="{StaticResource Ink}"
        Background="{StaticResource Sheet}">

    <StackPanel Margin="26,20,26,18" Spacing="0">
        <TextBlock Text="{l:T meeting.delete.title}" Classes="label" />
        <Border BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,2" Margin="0,7,0,0" />

        <TextBlock x:Name="Heading" Margin="0,16,0,0" FontSize="15.5" LineHeight="23"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="Warning" Margin="0,10,0,0" FontSize="12.5" LineHeight="20"
                   TextWrapping="Wrap" Foreground="{StaticResource Ink2}"
                   Text="{l:T meeting.delete.body}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"
                    Margin="0,20,0,0">
            <!-- The filled button keeps the meeting. The destructive one is never the button a
                 hurried operator hits by reflex, and never the one Enter presses. -->
            <Button x:Name="Delete" Content="{l:T meeting.delete.confirm}" Click="OnDeleteClick" />
            <Button x:Name="Keep" Classes="accent" Content="{l:T meeting.delete.cancel}"
                    IsDefault="True" IsCancel="True" Click="OnKeepClick" />
        </StackPanel>
    </StackPanel>
</Window>

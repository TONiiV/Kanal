<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Kanal.Host.Controls"
             xmlns:sys="using:System"
             xmlns:vm="using:Kanal.Host.ViewModels"
             xmlns:l="using:Kanal.Host.Localization"
             x:Class="Kanal.Host.Views.SidePanelView" x:DataType="vm:MainViewModel">
    <UserControl.Styles>
        <!-- Retemplated only to put a ScrollViewer round the header strip: Fluent's TabControl has
             none, so a narrow right column wraps the tabs onto a second row instead of scrolling. -->
        <Style Selector="TabControl">
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <DockPanel>
                        <!-- The padding is the lane the overlaid scrollbar lands in; without it the
                             thumb sits level with the selection pipe and reads as a second tab. -->
                        <ScrollViewer DockPanel.Dock="Top" Name="TabStrip" Padding="0,0,0,8"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <ItemsPresenter Name="PART_ItemsPresenter"
                                            ItemsPanel="{TemplateBinding ItemsPanel}" />
                        </ScrollViewer>
                        <ContentPresenter Name="PART_SelectedContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectedContent}"
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                    </DockPanel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontFamily" Value="{StaticResource Sans}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="LetterSpacing" Value="1.2" />
            <Setter Property="Foreground" Value="{StaticResource Ink3}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0,0,0,10" />
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="TabItem:pointerover">
            <Setter Property="Foreground" Value="{StaticResource Ink2}" />
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <!-- Fluent draws the marker in the system accent; the host is ink and paper. It sits flush
             under the header content, which is why each header carries its own bottom margin -
             without it the rule strikes through the descenders of "Points". -->
        <Style Selector="TabItem /template/ Border#PART_SelectedPipe">
            <Setter Property="Background" Value="{StaticResource Ink}" />
        </Style>
    </UserControl.Styles>

    <Border BorderBrush="{StaticResource Rule}" BorderThickness="1,0,0,0">
        <DockPanel>
            <Border DockPanel.Dock="Top" Classes="sidebar-header"
                    MinHeight="{Binding Shell.HeaderHeight}">
                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Left" Classes="ghost chevron" x:Name="CollapseAssistant"
                            Command="{Binding Shell.Right.ToggleCommand}"
                            ToolTip.Tip="{l:T sidebar.collapse.tip}"
                            AutomationProperties.Name="{l:T sidebar.collapse.tip}">
                        <Path Classes="glyph" Data="{c:Icon chevron-right}" />
                    </Button>
                    <TextBlock DockPanel.Dock="Right" Classes="label" x:Name="AssistantTitle"
                               Text="{l:T sidebar.assistant}" />
                </DockPanel>
            </Border>

            <TabControl Padding="0" Margin="20,14,0,0">
                <TabItem x:Name="PointsTab" AutomationProperties.Name="{l:T assistant.tab.points}">
                    <TabItem.Header>
                        <TextBlock Text="{l:T assistant.tab.points}" Margin="0,0,0,7" />
                    </TabItem.Header>
                    <Border Margin="0,0,20,0" Padding="0,16,0,16" BorderBrush="{StaticResource Rule}"
                            BorderThickness="0,1,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" x:Name="NoAnalystNote"
                                       Text="{l:T assistant.noanalyst}" TextWrapping="Wrap"
                                       FontSize="12.5" LineHeight="19" Foreground="{StaticResource Ink3}"
                                       IsVisible="{Binding Assistant.ShowNoAnalystNote}" />
                            <TextBlock DockPanel.Dock="Top" x:Name="NothingYetNote"
                                       Text="{l:T assistant.nothingyet}" TextWrapping="Wrap"
                                       FontSize="12.5" Foreground="{StaticResource Ink3}"
                                       IsVisible="{Binding Assistant.ShowNothingFoundYet}" />
                            <ScrollViewer x:Name="InsightList"
                                          IsVisible="{Binding Assistant.IsAnalystConnected}">
                                <ItemsControl ItemsSource="{Binding Assistant.Topics}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:InsightTopicViewModel">
                                            <StackPanel Margin="0,0,0,22">
                                                <TextBlock Text="{Binding Topic}" Classes="label" />
                                                <Border BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,1"
                                                        Margin="0,6,0,12" />
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:InsightItemViewModel">
                                                            <StackPanel Margin="0,0,0,18" Spacing="6">
                                                                <StackPanel Orientation="Horizontal" Spacing="9">
                                                                    <TextBlock Text="{Binding KindLabel}" FontSize="10"
                                                                               FontWeight="Bold" LetterSpacing="1.2"
                                                                               Foreground="{StaticResource Ink2}" />
                                                                    <TextBlock Text="{Binding StateLabel}" FontSize="10"
                                                                               LetterSpacing="0.6"
                                                                               Foreground="{StaticResource Ink3}" />
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                                           FontSize="13.5" LineHeight="21"
                                                                           Foreground="{StaticResource Ink}" />
                                                                <ItemsControl ItemsSource="{Binding Sources}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="sys:String">
                                                                            <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                                                       FontSize="11.5" LineHeight="17"
                                                                                       Margin="9,0,0,3"
                                                                                       Foreground="{StaticResource Ink3}" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                                    <Button Content="{l:T insight.confirm}"
                                                                            Classes="ghost" Padding="9,4"
                                                                            IsVisible="{Binding IsCandidate}"
                                                                            Command="{Binding ConfirmCommand}"
                                                                            ToolTip.Tip="{l:T insight.confirm.tip}"
                                                                            AutomationProperties.Name="{l:T insight.confirm.tip}" />
                                                                    <Button Content="×" Classes="ghost" Padding="9,4"
                                                                            Command="{Binding DismissCommand}"
                                                                            ToolTip.Tip="{l:T insight.dismiss.tip}"
                                                                            AutomationProperties.Name="{l:T insight.dismiss.tip}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </TabItem>

                <TabItem x:Name="SpeakersTab" AutomationProperties.Name="{l:T assistant.tab.speakers}">
                    <TabItem.Header>
                        <TextBlock Text="{l:T assistant.tab.speakers}" Margin="0,0,0,7" />
                    </TabItem.Header>
                    <Border Margin="0,0,20,0" Padding="0,16,0,16" BorderBrush="{StaticResource Rule}"
                            BorderThickness="0,1,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                                <TextBlock Text="{l:T merge.label}" Classes="label" />
                                <Border BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,1" Margin="0,6,0,10" />
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <TextBox x:Name="MergeFrom" Text="{Binding MergeFromTag}" PlaceholderText="S03" Width="58" />
                                    <TextBlock Text="→" VerticalAlignment="Center" Foreground="{StaticResource Ink3}" />
                                    <TextBox x:Name="MergeInto" Text="{Binding MergeIntoTag}" PlaceholderText="S01" Width="58" />
                                </StackPanel>
                                <Button x:Name="MergeSpeakers" Content="{l:T merge.button}"
                                        Command="{Binding MergeSpeakersCommand}"
                                        HorizontalAlignment="Left" Margin="0,8,0,0" />
                            </StackPanel>

                            <ScrollViewer>
                                <ItemsControl x:Name="SpeakerList" ItemsSource="{Binding Speakers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SpeakerItemViewModel">
                                            <Grid ColumnDefinitions="3,*,Auto" Margin="0,0,0,14">
                                                <Rectangle Grid.Column="0" Width="3" Fill="{Binding Color}"
                                                           VerticalAlignment="Stretch" />
                                                <StackPanel Grid.Column="1" Margin="11,0,0,0" Spacing="5">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <TextBlock Text="{Binding Tag}" FontSize="10.5" FontWeight="Bold"
                                                                   LetterSpacing="1.2" Foreground="{Binding Color}" />
                                                        <TextBlock Text="{Binding MergedFromLabel}" FontSize="10.5"
                                                                   Foreground="{StaticResource Ink3}" />
                                                    </StackPanel>
                                                    <TextBox Text="{Binding Name}" PlaceholderText="{l:T speaker.placeholder}">
                                                        <TextBox.KeyBindings>
                                                            <KeyBinding Gesture="Enter" Command="{Binding RenameCommand}" />
                                                        </TextBox.KeyBindings>
                                                    </TextBox>
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="✓" Classes="ghost" Padding="10,5"
                                                        VerticalAlignment="Bottom" Command="{Binding RenameCommand}"
                                                        ToolTip.Tip="{l:T speaker.apply.tip}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </TabItem>

                <TabItem x:Name="FilesTab" AutomationProperties.Name="{l:T assistant.tab.files}">
                    <TabItem.Header>
                        <TextBlock Text="{l:T assistant.tab.files}" Margin="0,0,0,7" />
                    </TabItem.Header>
                    <Border Margin="0,0,20,0" Padding="0,16,0,16" BorderBrush="{StaticResource Rule}"
                            BorderThickness="0,1,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Bottom" x:Name="ImportFile" Classes="ghost"
                                    Margin="0,16,0,0" Padding="9,6" HorizontalAlignment="Left"
                                    Command="{Binding Files.ImportCommand}"
                                    ToolTip.Tip="{l:T files.import.tip}"
                                    AutomationProperties.Name="{l:T files.import.tip}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Classes="glyph" Data="{c:Icon arrow-down}" Width="13" Height="13" />
                                    <TextBlock Text="{l:T files.import}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <TextBlock DockPanel.Dock="Bottom" x:Name="FilesProblem"
                                       Text="{Binding Files.ProblemNote}" TextWrapping="Wrap"
                                       Margin="0,12,0,0" FontSize="11.5" LineHeight="17"
                                       Foreground="{StaticResource Alarm}"
                                       IsVisible="{Binding Files.ProblemNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                            <TextBlock DockPanel.Dock="Top" x:Name="NoFilesNote"
                                       Text="{Binding Files.EmptyNote}" TextWrapping="Wrap"
                                       FontSize="12.5" LineHeight="19" Foreground="{StaticResource Ink3}"
                                       IsVisible="{Binding Files.IsEmpty}" />

                            <ScrollViewer x:Name="FileTree">
                                <ItemsControl ItemsSource="{Binding Files.Entries}"
                                              AutomationProperties.Name="{l:T assistant.tab.files}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MeetingFileViewModel">
                                            <Border BorderBrush="{StaticResource RuleFaint}"
                                                    BorderThickness="0,0,0,1" Padding="0,8">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"
                                                      Margin="{Binding Nesting}">
                                                    <TextBlock Text="{Binding Label}" FontSize="12.5"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource Ink}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding SizeLabel}"
                                                               FontSize="10.5" VerticalAlignment="Center"
                                                               Foreground="{StaticResource Ink3}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</UserControl>

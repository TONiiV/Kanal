<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kanal.Host.ViewModels"
             xmlns:l="using:Kanal.Host.Localization"
             x:Class="Kanal.Host.Views.SidePanelView" x:DataType="vm:MainViewModel"
             Width="272">
    <Border BorderBrush="{StaticResource Rule}" BorderThickness="1,0,0,0" Padding="20,20,20,16">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" IsVisible="{Binding HasJoinInfo}" Margin="0,0,0,22">
                <TextBlock Text="{l:T join.label}" Classes="label" />
                <Border BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,1" Margin="0,6,0,12" />
                <Image Source="{Binding QrImage}" Width="196" Height="196" HorizontalAlignment="Left"
                       RenderOptions.BitmapInterpolationMode="None" />
                <TextBox Text="{Binding JoinUrl}" IsReadOnly="True" FontSize="10" Height="48"
                         TextWrapping="Wrap" AcceptsReturn="True" Margin="0,10,0,0" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Top" IsVisible="{Binding HasJoinError}" Margin="0,0,0,22">
                <TextBlock Text="{l:T join.label}" Classes="label" />
                <Border BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,1" Margin="0,6,0,12" />
                <TextBlock Text="{Binding JoinError}" TextWrapping="Wrap"
                           Foreground="{StaticResource Ink2}" FontSize="12" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                <TextBlock Text="{l:T merge.label}" Classes="label" />
                <Border BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,1" Margin="0,6,0,10" />
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBox Text="{Binding MergeFromTag}" PlaceholderText="S03" Width="58" />
                    <TextBlock Text="→" VerticalAlignment="Center" Foreground="{StaticResource Ink3}" />
                    <TextBox Text="{Binding MergeIntoTag}" PlaceholderText="S01" Width="58" />
                </StackPanel>
                <Button Content="{l:T merge.button}" Command="{Binding MergeSpeakersCommand}"
                        HorizontalAlignment="Left" Margin="0,8,0,0" />
            </StackPanel>

            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{l:T speakers.label}" Classes="label" />
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,1"
                        Margin="0,6,0,12" />
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Speakers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SpeakerItemViewModel">
                                <Grid ColumnDefinitions="3,*,Auto" Margin="0,0,0,14">
                                    <Rectangle Grid.Column="0" Width="3" Fill="{Binding Color}"
                                               VerticalAlignment="Stretch" />
                                    <StackPanel Grid.Column="1" Margin="11,0,0,0" Spacing="5">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <TextBlock Text="{Binding Tag}" FontSize="10.5" FontWeight="Bold"
                                                       LetterSpacing="1.2" Foreground="{Binding Color}" />
                                            <TextBlock Text="{Binding MergedFromLabel}" FontSize="10.5"
                                                       Foreground="{StaticResource Ink3}" />
                                        </StackPanel>
                                        <TextBox Text="{Binding Name}" PlaceholderText="{l:T speaker.placeholder}">
                                            <TextBox.KeyBindings>
                                                <KeyBinding Gesture="Enter" Command="{Binding RenameCommand}" />
                                            </TextBox.KeyBindings>
                                        </TextBox>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="✓" Classes="ghost" Padding="10,5"
                                            VerticalAlignment="Bottom" Command="{Binding RenameCommand}"
                                            ToolTip.Tip="{l:T speaker.apply.tip}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </DockPanel>
    </Border>
</UserControl>

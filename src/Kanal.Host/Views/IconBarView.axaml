<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Kanal.Host.Controls"
             xmlns:vm="using:Kanal.Host.ViewModels"
             xmlns:l="using:Kanal.Host.Localization"
             x:Class="Kanal.Host.Views.IconBarView" x:DataType="vm:MainViewModel">
    <StackPanel>
        <Border x:Name="Bar" Classes="chrome-head" Padding="12,0">
            <!-- Outside the columns: a collapsed sidebar is reachable only through these. -->
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="{Binding Shell.CenterStartInset}" />
                <Button DockPanel.Dock="Left" Classes="ghost icon" x:Name="ExpandWorkspace"
                        Margin="0,0,8,0" IsVisible="{Binding Shell.Left.CanExpand}"
                        Command="{Binding Shell.Left.ToggleCommand}"
                        ToolTip.Tip="{l:T sidebar.workspace.show.tip}"
                        AutomationProperties.Name="{l:T sidebar.workspace.show.tip}">
                    <Path Classes="glyph" Data="{c:Icon sidebar}" Width="18" Height="18" />
                </Button>
                <Border DockPanel.Dock="Right" Width="{Binding Shell.CenterEndInset}" />
                <Button DockPanel.Dock="Right" Classes="ghost icon" x:Name="ExpandAssistant"
                        Margin="8,0,0,0" IsVisible="{Binding Shell.Right.CanExpand}"
                        Command="{Binding Shell.Right.ToggleCommand}"
                        ToolTip.Tip="{l:T sidebar.assistant.show.tip}"
                        AutomationProperties.Name="{l:T sidebar.assistant.show.tip}">
                    <Path Classes="glyph" Data="{c:Icon sidebar}" Width="18" Height="18"
                          RenderTransformOrigin="50%,50%" RenderTransform="scaleX(-1)" />
                </Button>

                <!-- A starred column gives up width, an Auto one does not: the transport must keep
                     every pixel it asked for, so the side clusters clip instead of the bar scrolling. -->
                <Grid ColumnDefinitions="*,Auto,*" x:Name="BarGrid">
                    <Grid Grid.Column="0" x:Name="LeftCluster"
                          ColumnSpacing="8" VerticalAlignment="Center" ClipToBounds="True">
                        <Grid.ColumnDefinitions>
                            <!-- Starred so the mode box is the one thing here that gives up width -
                                 the picker beside it is a glyph and a chevron with nothing to trim,
                                 so a cluster that shrank evenly would cut its chevron off rather
                                 than shorten a label. Capped so the column stops at the box: an
                                 open starred column takes every spare pixel in the window, and the
                                 help button that explains the mode lands at the far right of it,
                                 against the transport it says nothing about. The box stretches to
                                 the cap rather than to its own text, so the button beside it holds
                                 still as the mode and the language change. -->
                            <ColumnDefinition Width="*" MaxWidth="160" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}"
                                  HorizontalAlignment="Stretch"
                                  IsEnabled="{Binding !IsRunning}" VerticalAlignment="Center"
                                  ToolTip.Tip="{Binding SelectedMode.Name}"
                                  AutomationProperties.Name="{l:T mode.tip}">
                            <ComboBox.ItemContainerTheme>
                                <ControlTheme TargetType="ComboBoxItem" x:DataType="vm:PipelineModeOption"
                                              BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                    <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                                </ControlTheme>
                            </ComboBox.ItemContainerTheme>
                            <ComboBox.SelectionBoxItemTemplate>
                                <DataTemplate x:DataType="vm:PipelineModeOption">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                        <Path Grid.Column="0" Classes="glyph mode" Data="{Binding Mark}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Short}" FontSize="12.5"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.SelectionBoxItemTemplate>
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PipelineModeOption">
                                    <Grid ColumnDefinitions="Auto,*" Margin="0,3,0,4" MaxWidth="330">
                                        <Path Grid.Column="0" Classes="mode" Width="16" Height="16"
                                              Stretch="Uniform" Margin="0,1,10,0" VerticalAlignment="Top"
                                              Data="{Binding Mark}" />
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detail}" FontSize="10.5" LineHeight="15"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource Ink3}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Grid.Column="1" Classes="ghost icon compact" Content="?" FontWeight="Bold"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{l:T modes.tip}"
                                AutomationProperties.Name="{l:T modes.tip}">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Margin="20,17,20,8" Width="424">
                                            <TextBlock Text="{l:T modes.heading}" Classes="label" />
                                            <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1"
                                                    Margin="0,6,0,12" />
                                            <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                                                       Margin="0,0,0,15" Foreground="{StaticResource Ink2}"
                                                       Text="{l:T modes.intro}" />
                                            <ItemsControl ItemsSource="{Binding Modes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PipelineModeOption">
                                                        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,14">
                                                            <Path Grid.Column="0" Width="13" Height="13" Stretch="Uniform"
                                                                  Margin="0,3,9,0" VerticalAlignment="Top"
                                                                  Data="{c:Icon square-filled}"
                                                                  Fill="{StaticResource Ink}"
                                                                  IsVisible="{Binding IsAvailable}" />
                                                            <Path Grid.Column="0" Width="13" Height="13" Stretch="Uniform"
                                                                  Margin="0,3,9,0" VerticalAlignment="Top"
                                                                  Data="{c:Icon square-hollow}"
                                                                  Fill="{StaticResource Ink3}"
                                                                  IsVisible="{Binding !IsAvailable}" />
                                                            <StackPanel Grid.Column="1" Spacing="3">
                                                                <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                <TextBlock FontSize="10.5" LetterSpacing="0.4"
                                                                           TextWrapping="Wrap" LineHeight="15"
                                                                           Foreground="{StaticResource Ink3}">
                                                                    <Run Text="{Binding Status, Mode=OneWay}" />
                                                                    <Run Text=" · " />
                                                                    <Run Text="{Binding Mode.Leaves, Mode=OneWay}" />
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding Help}" TextWrapping="Wrap"
                                                                           FontSize="11.5" LineHeight="17"
                                                                           Foreground="{StaticResource Ink2}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <ComboBox Grid.Column="2" ItemsSource="{Binding CaptureProfiles}"
                                  SelectedItem="{Binding SelectedCaptureProfile}"
                                  Width="68" IsEnabled="{Binding CanChooseAudio}" VerticalAlignment="Center"
                                  IsVisible="{Binding NeedsMicrophone}"
                                  ToolTip.Tip="{Binding CaptureTip}"
                                  AutomationProperties.Name="{Binding CaptureTip}">
                            <ComboBox.SelectionBoxItemTemplate>
                                <DataTemplate x:DataType="vm:CaptureProfileOption">
                                    <Panel VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Path Classes="glyph" Data="{c:Icon people}"
                                              IsVisible="{Binding IsInRoom}" />
                                        <Path Classes="glyph" Data="{c:Icon screen}"
                                              IsVisible="{Binding !IsInRoom}" />
                                    </Panel>
                                </DataTemplate>
                            </ComboBox.SelectionBoxItemTemplate>
                            <ComboBox.Styles>
                                <Style Selector="ComboBoxItem" x:DataType="vm:CaptureProfileOption">
                                    <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                                </Style>
                                <Style Selector="ComboBoxItem:disabled TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Ink3}" />
                                </Style>
                            </ComboBox.Styles>
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:CaptureProfileOption">
                                    <Grid ColumnDefinitions="Auto,*" MaxWidth="300" Margin="0,3,0,4">
                                        <Panel Grid.Column="0" Margin="0,2,9,0" VerticalAlignment="Top">
                                            <Path Classes="glyph" Data="{c:Icon people}" Width="15" Height="15"
                                                  IsVisible="{Binding IsInRoom}" />
                                            <Path Classes="glyph" Data="{c:Icon screen}" Width="15" Height="15"
                                                  IsVisible="{Binding !IsInRoom}" />
                                        </Panel>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Guidance}" FontSize="10.5" LineHeight="15"
                                                       TextWrapping="Wrap" Foreground="{StaticResource Ink3}" />
                                            <TextBlock Text="{Binding Unavailable}" FontSize="10.5" LineHeight="15"
                                                       TextWrapping="Wrap" FontWeight="SemiBold"
                                                       IsVisible="{Binding !IsAvailable}"
                                                       Foreground="{StaticResource Ink2}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <StackPanel Grid.Column="1" x:Name="TransportGroup" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="20,0">
                        <StackPanel x:Name="Transport" Orientation="Horizontal" Spacing="6"
                                    VerticalAlignment="Center">
                            <Button Classes="mark" x:Name="RecordMark" Command="{Binding StartCommand}"
                                    IsVisible="{Binding ShowRecord}"
                                    ToolTip.Tip="{l:T transport.record.tip}"
                                    AutomationProperties.Name="{l:T transport.start}">
                                <Path Classes="record disc" Data="{c:Icon record}" />
                            </Button>

                            <Button Classes="mark hold" x:Name="PauseMark" Command="{Binding PauseCommand}"
                                    IsVisible="{Binding ShowPause}"
                                    ToolTip.Tip="{Binding PauseTip}"
                                    AutomationProperties.Name="{Binding PauseLabel}">
                                <Panel>
                                    <Path Classes="hold" Data="{c:Icon pause}" IsVisible="{Binding !IsPaused}" />
                                    <Path Classes="hold" Data="{c:Icon play}" IsVisible="{Binding IsPaused}" />
                                </Panel>
                            </Button>

                            <Button Classes="mark" x:Name="StopMark" Command="{Binding StopCommand}"
                                    IsVisible="{Binding ShowStop}"
                                    ToolTip.Tip="{Binding StopTip}"
                                    AutomationProperties.Name="{l:T transport.stop}">
                                <Panel>
                                    <Arc x:Name="StartingSpinner" Classes="spinner"
                                         IsVisible="{Binding IsStarting}" />
                                    <Path Classes="record" Data="{c:Icon stop}" />
                                </Panel>
                            </Button>
                        </StackPanel>

                        <StackPanel x:Name="TransportStatus" VerticalAlignment="Center">
                            <StackPanel Margin="12,0,0,0" IsVisible="{Binding IsRunning}">
                                <TextBlock Text="{l:T workspace.recording}" Classes="label" IsVisible="{Binding !IsPaused}" />
                                <TextBlock Text="{l:T recording.held}" Classes="label" IsVisible="{Binding IsPaused}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <c:EndAlignedStack Grid.Column="2" x:Name="RightCluster" Orientation="Horizontal"
                                       Spacing="4" VerticalAlignment="Center" ClipToBounds="True">
                        <Button Classes="ghost icon" x:Name="AudioDevices"
                                IsVisible="{Binding NeedsMicrophone}"
                                ToolTip.Tip="{l:T audio.tip}"
                                AutomationProperties.Name="{l:T audio.tip}">
                            <Path Classes="glyph" Data="{c:Icon microphone}" Width="18" Height="18" />
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel Margin="20,17,20,17" Width="292" Spacing="14">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{l:T input.label}" Classes="label" />
                                            <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                                      HorizontalAlignment="Stretch" IsEnabled="{Binding CanChooseAudio}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding MicLevel}" Height="5"
                                                         Foreground="{StaticResource Ink}" Background="{StaticResource RuleFaint}"
                                                         CornerRadius="0" AutomationProperties.Name="{l:T input.label}" />
                                        </StackPanel>
                                        <StackPanel Spacing="6" IsVisible="{Binding NeedsComputerAudio}">
                                            <TextBlock Text="{l:T computer.label}" Classes="label" />
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ComputerLevel}" Height="5"
                                                         Foreground="{StaticResource Ink}" Background="{StaticResource RuleFaint}"
                                                         CornerRadius="0" AutomationProperties.Name="{l:T computer.label}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding AudioSourceStatus}" TextWrapping="Wrap" FontSize="11.5"
                                                   Foreground="{StaticResource Ink2}" IsVisible="{Binding HasAudioSourceStatus}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!-- Parked here until #69 gives the meeting record its own menu. -->
                        <Button Classes="ghost icon" x:Name="MeetingMore"
                                ToolTip.Tip="{l:T meeting.more.tip}"
                                AutomationProperties.Name="{l:T meeting.more.tip}">
                            <Path Classes="glyph" Data="{c:Icon ellipsis}" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="{l:T export.button}" Command="{Binding ExportMarkdownCommand}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <Button Classes="ghost icon" x:Name="JoinQr"
                                IsEnabled="{Binding CanShowJoin}"
                                ToolTip.Tip="{l:T join.tip}"
                                AutomationProperties.Name="{l:T join.tip}">
                            <Path Classes="glyph" Data="{c:Icon qr}" />
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel Margin="20,17,20,17" Width="236">
                                        <TextBlock Text="{l:T join.label}" Classes="label" />
                                        <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1"
                                                Margin="0,6,0,12" />
                                        <StackPanel IsVisible="{Binding HasJoinInfo}">
                                            <Image Source="{Binding QrImage}" Width="196" Height="196"
                                                   HorizontalAlignment="Left"
                                                   RenderOptions.BitmapInterpolationMode="None" />
                                            <TextBox Text="{Binding JoinUrl}" IsReadOnly="True" FontSize="10"
                                                     Height="48" TextWrapping="Wrap" AcceptsReturn="True"
                                                     Margin="0,10,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding JoinError}" IsVisible="{Binding HasJoinError}"
                                                   TextWrapping="Wrap" Foreground="{StaticResource Ink2}"
                                                   FontSize="12" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </c:EndAlignedStack>
                </Grid>
            </DockPanel>
        </Border>

        <Border IsVisible="{Binding ShowCaptureNote}"
                BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1"
                Background="{StaticResource Paper}" Padding="28,9">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CaptureProfileGuidance}" FontSize="11.5"
                               Foreground="{StaticResource Ink2}" TextWrapping="Wrap"
                               IsVisible="{Binding ShowCaptureGuidance}" />
                    <TextBlock Text="{Binding SelectedCaptureProfile.Unavailable}" FontSize="10.5"
                               FontWeight="SemiBold" Foreground="{StaticResource Alarm}"
                               TextWrapping="Wrap" IsVisible="{Binding !SelectedCaptureProfile.IsAvailable}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost" Padding="9,4"
                        VerticalAlignment="Center" Margin="10,0,0,0"
                        Command="{Binding DismissCaptureNoteCommand}"
                        IsVisible="{Binding ShowCaptureGuidance}"
                        ToolTip.Tip="{l:T capture.note.dismiss.tip}"
                        AutomationProperties.Name="{l:T capture.note.dismiss.tip}">
                    <Path Classes="glyph" Data="{c:Icon close}" Width="12" Height="12" />
                </Button>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>

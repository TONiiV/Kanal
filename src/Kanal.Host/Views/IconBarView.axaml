<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kanal.Host.ViewModels"
             xmlns:controls="using:Kanal.Host.Controls"
             xmlns:l="using:Kanal.Host.Localization"
             x:Class="Kanal.Host.Views.IconBarView" x:DataType="vm:MainViewModel">
    <StackPanel>
        <Border BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,2"
                Padding="16,9">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <!-- Two clusters, not one undifferentiated run. What drives the meeting - transport,
                     mode, languages - holds the left edge where the operator's eye starts. What is
                     set once and then left alone - input, export, settings - holds the right. The
                     ScrollViewer stretches this to the viewport, so the right cluster stays on the
                     edge until the bar is too narrow, at which point the whole row scrolls
                     horizontally rather than wrapping or dropping a meeting control. -->
                <DockPanel LastChildFill="False" Grid.IsSharedSizeScope="True">
                    <StackPanel x:Name="LeftCluster" DockPanel.Dock="Left" Orientation="Horizontal"
                                Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Transport" />
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding StartCommand}" Classes="accent"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Path Classes="glyph" Data="{StaticResource GlyphPlay}" Width="10" Height="12"
                                          Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="{l:T transport.start}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Transport" />
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding PauseCommand}" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" ToolTip.Tip="{l:T transport.pause.tip}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Path Classes="glyph" Data="{StaticResource GlyphPause}" Width="10" Height="12"
                                          Stretch="Uniform" VerticalAlignment="Center" IsVisible="{Binding !IsPaused}" />
                                    <Path Classes="glyph" Data="{StaticResource GlyphPlay}" Width="10" Height="12"
                                          Stretch="Uniform" VerticalAlignment="Center" IsVisible="{Binding IsPaused}" />
                                    <TextBlock Text="{Binding PauseLabel}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Transport" />
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding StopCommand}" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Path Classes="glyph" Data="{StaticResource GlyphStop}" Width="11" Height="11"
                                          Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="{l:T transport.stop}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Rectangle Width="1" Height="20" Fill="{StaticResource Rule}"
                                   VerticalAlignment="Center" Margin="4,0" />

                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <TextBlock Text="{l:T mode.label}" Classes="label" />
                            <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}"
                                      Width="300" IsEnabled="{Binding !IsRunning}" VerticalAlignment="Center">
                                <ComboBox.ItemContainerTheme>
                                    <ControlTheme TargetType="ComboBoxItem" x:DataType="vm:PipelineModeOption"
                                                  BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                        <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                                    </ControlTheme>
                                </ComboBox.ItemContainerTheme>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PipelineModeOption">
                                        <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,3">
                                            <Path Grid.Column="0" Width="8" Height="8" Stretch="Uniform"
                                                  Margin="0,5,10,0" VerticalAlignment="Top"
                                                  Data="{StaticResource GlyphSquareFilled}" Fill="{StaticResource Ink}"
                                                  IsVisible="{Binding IsAvailable}" />
                                            <Path Grid.Column="0" Width="8" Height="8" Stretch="Uniform"
                                                  Margin="0,5,10,0" VerticalAlignment="Top"
                                                  Data="{StaticResource GlyphSquareHollow}" Fill="{StaticResource Ink3}"
                                                  IsVisible="{Binding !IsAvailable}" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" />
                                                <TextBlock Text="{Binding Detail}" FontSize="10.5" LineHeight="15"
                                                           TextWrapping="Wrap" MaxWidth="260"
                                                           Foreground="{StaticResource Ink3}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Classes="ghost" Content="?" Padding="10,5" FontWeight="Bold"
                                    ToolTip.Tip="{l:T modes.tip}">
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel Margin="20,17,20,8" Width="424">
                                                <TextBlock Text="{l:T modes.heading}" Classes="label" />
                                                <Border BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,2"
                                                        Margin="0,6,0,12" />
                                                <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="19"
                                                           Margin="0,0,0,15" Foreground="{StaticResource Ink2}"
                                                           Text="{l:T modes.intro}" />
                                                <ItemsControl ItemsSource="{Binding Modes}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:PipelineModeOption">
                                                            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,14">
                                                                <Path Grid.Column="0" Width="8" Height="8" Stretch="Uniform"
                                                                      Margin="0,5,11,0" VerticalAlignment="Top"
                                                                      Data="{StaticResource GlyphSquareFilled}"
                                                                      Fill="{StaticResource Ink}"
                                                                      IsVisible="{Binding IsAvailable}" />
                                                                <Path Grid.Column="0" Width="8" Height="8" Stretch="Uniform"
                                                                      Margin="0,5,11,0" VerticalAlignment="Top"
                                                                      Data="{StaticResource GlyphSquareHollow}"
                                                                      Fill="{StaticResource Ink3}"
                                                                      IsVisible="{Binding !IsAvailable}" />
                                                                <StackPanel Grid.Column="1" Spacing="3">
                                                                    <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                    <TextBlock FontSize="10.5" LetterSpacing="0.4"
                                                                               TextWrapping="Wrap" LineHeight="15"
                                                                               Foreground="{StaticResource Ink3}">
                                                                        <Run Text="{Binding Status, Mode=OneWay}" />
                                                                        <Run Text=" · " />
                                                                        <Run Text="{Binding Mode.Leaves, Mode=OneWay}" />
                                                                    </TextBlock>
                                                                    <TextBlock Text="{Binding Help}" TextWrapping="Wrap"
                                                                               FontSize="11.5" LineHeight="17"
                                                                               Foreground="{StaticResource Ink2}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"
                                    IsVisible="{Binding NeedsMicrophone}">
                            <TextBlock Text="{l:T capture.label}" Classes="label" />
                            <ComboBox ItemsSource="{Binding CaptureProfiles}"
                                      SelectedItem="{Binding SelectedCaptureProfile}"
                                      Width="166" IsEnabled="{Binding !IsRunning}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CaptureProfileOption">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <TextBlock Text="{l:T languages.label}" Classes="label" />
                            <Button Classes="ghost" Padding="5,3" Click="OnLanguagesClick"
                                    IsEnabled="{Binding !IsRunning}" ToolTip.Tip="{l:T languages.tip}">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ItemsControl ItemsSource="{Binding SelectedLanguages}" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="-8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:LanguageOption">
                                                <Border Background="{StaticResource Sheet}" CornerRadius="13" Padding="2">
                                                    <controls:FlagIcon Code="{Binding Code}" Width="22" Height="22" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding SelectedLanguageSummary}" FontSize="12"
                                               Foreground="{StaticResource Ink2}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="RightCluster" DockPanel.Dock="Right" Orientation="Horizontal"
                                Spacing="8" Margin="16,0,0,0">
                        <!-- The microphone reads as one instrument: the glyph is the mute switch,
                             the meter beside it says the room is actually arriving, and the caret
                             opens the list of inputs. Muted is a struck-through microphone and a
                             meter at rest, so the state is legible without reading a word. -->
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                                    IsVisible="{Binding NeedsMicrophone}">
                            <Button Command="{Binding ToggleMuteCommand}" Classes="ghost" Padding="8,6"
                                    ToolTip.Tip="{Binding MuteTip}"
                                    AutomationProperties.Name="{Binding MuteTip}">
                                <Panel>
                                    <Path Classes="glyph" Data="{StaticResource GlyphMic}" Width="14" Height="14"
                                          Stretch="Uniform" VerticalAlignment="Center"
                                          IsVisible="{Binding !IsMuted}" />
                                    <Path Classes="glyph" Data="{StaticResource GlyphMicMuted}" Width="14"
                                          Height="14" Stretch="Uniform" VerticalAlignment="Center"
                                          IsVisible="{Binding IsMuted}" />
                                </Panel>
                            </Button>

                            <!-- The wrapper reserves the meter's slot whether or not the meter
                                 is in it, so going live does not shove the picker sideways.
                                 MinWidth="0" is not decoration: Fluent's ProgressBar theme
                                 sets MinWidth="200", which silently wins over Width. -->
                            <Panel Width="60" VerticalAlignment="Center">
                                <ProgressBar x:Name="MicMeter" Value="{Binding MicLevel}" Maximum="100"
                                             Width="52" MinWidth="0" Height="4" CornerRadius="0"
                                             IsVisible="{Binding ShowMicLevel}"
                                             HorizontalAlignment="Left" VerticalAlignment="Center"
                                             Margin="2,0,6,0"
                                             Foreground="{StaticResource Ink}"
                                             Background="{StaticResource RuleFaint}" />
                            </Panel>

                            <!-- The name is the microphone, not the verb. A button whose content
                                 is a panel has no name of its own - Avalonia falls back to the
                                 content's type name - and the verb is still announced, as the
                                 tooltip's help text. -->
                            <Button x:Name="DevicePicker" Classes="ghost" Padding="6,6"
                                    IsEnabled="{Binding !IsRunning}" ToolTip.Tip="{l:T input.pick}"
                                    AutomationProperties.Name="{Binding SelectedDeviceLabel}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <TextBlock Text="{Binding SelectedDeviceLabel}" FontSize="12"
                                               MaxWidth="160" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <Path Classes="glyph" Data="{StaticResource GlyphChevronDown}" Width="9"
                                          Height="5" Stretch="Uniform" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight"
                                            Opening="OnDevicePickerOpening">
                                        <ListBox x:Name="DeviceList" ItemsSource="{Binding Devices}"
                                                 Tapped="OnDeviceCommitted"
                                                 KeyDown="OnDevicePickerKey"
                                                 Background="Transparent" BorderThickness="0"
                                                 MinWidth="240" MaxHeight="320" Padding="6">
                                            <!-- The only list of its kind in the application, so
                                                 its rows are squared off here rather than in a
                                                 global style: same paper block and same corners as
                                                 the mode list it sits beside. -->
                                            <ListBox.Styles>
                                                <Style Selector="ListBoxItem">
                                                    <Setter Property="CornerRadius" Value="0" />
                                                    <Setter Property="Padding" Value="9,3" />
                                                </Style>
                                                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                                    <Setter Property="Background" Value="{StaticResource Paper}" />
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource Ink}" />
                                                </Style>
                                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                                    <Setter Property="Background" Value="{StaticResource Rule}" />
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource Ink}" />
                                                </Style>
                                                <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                                    <Setter Property="Background" Value="{StaticResource Rule}" />
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource Ink}" />
                                                </Style>
                                            </ListBox.Styles>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="10"
                                                                Margin="0,3">
                                                        <Path Width="10" Height="10" Stretch="Uniform"
                                                              VerticalAlignment="Center"
                                                              Data="{StaticResource GlyphCheck}"
                                                              Fill="{StaticResource Ink}"
                                                              IsVisible="{Binding $parent[ListBoxItem].IsSelected}" />
                                                        <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"
                                    IsVisible="{Binding NeedsComputerAudio}">
                            <TextBlock Text="{l:T output.label}" Classes="label" />
                            <ComboBox ItemsSource="{Binding ComputerOutputs}"
                                      SelectedItem="{Binding SelectedComputerOutput}"
                                      Width="200" IsEnabled="{Binding !IsRunning}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <Rectangle Width="1" Height="20" Fill="{StaticResource Rule}"
                                   VerticalAlignment="Center" Margin="4,0"
                                   IsVisible="{Binding NeedsMicrophone}" />
                        <Button Content="{l:T export.button}" Command="{Binding ExportMarkdownCommand}"
                                Classes="ghost" />
                        <Button Content="{l:T export.json.button}" Command="{Binding ExportJsonCommand}"
                                Classes="ghost" />
                        <Button Click="OnSettingsClick" Classes="ghost" Padding="8,6"
                                ToolTip.Tip="{l:T settings.tip}"
                                AutomationProperties.Name="{l:T settings.tip}">
                            <Path Classes="glyph" Data="{StaticResource GlyphSettings}" Width="14" Height="14"
                                  Stretch="Uniform" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </ScrollViewer>
        </Border>

        <Border IsVisible="{Binding ShowConsentGate}"
                BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1"
                Background="{StaticResource Paper}" Padding="24,9">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="13">
                <CheckBox Grid.Column="0" IsChecked="{Binding ConsentConfirmed}"
                          Content="{l:T consent.confirm}" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding ConsentReminder}" FontSize="11.5"
                               Foreground="{StaticResource Ink2}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CaptureProfileGuidance}" FontSize="10.5"
                               Foreground="{StaticResource Ink3}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedCaptureProfile.Unavailable}" FontSize="10.5"
                               FontWeight="SemiBold" Foreground="{StaticResource Alarm}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Border IsVisible="{Binding ShowProcessingNotice}"
                Background="{StaticResource Ink}" Padding="24,10">
            <TextBlock Text="{Binding LiveNoticeText}" FontSize="11.5" FontWeight="Bold"
                       LetterSpacing="1.1" Foreground="{StaticResource Sheet}" />
        </Border>

        <Border IsVisible="{Binding IsPaused}"
                Background="{StaticResource Ink}" Padding="24,10">
            <StackPanel Orientation="Horizontal" Spacing="13">
                <Path Data="{StaticResource GlyphPause}" Fill="{StaticResource Sheet}"
                      Width="9" Height="11" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Text="{l:T paused.band}" FontSize="11.5" FontWeight="Bold"
                           LetterSpacing="1.7" Foreground="{StaticResource Sheet}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Kanal.Host.Controls"
             xmlns:vm="using:Kanal.Host.ViewModels"
             xmlns:l="using:Kanal.Host.Localization"
             x:Class="Kanal.Host.Views.MeetingRoomView" x:DataType="vm:MainViewModel">
    <UserControl.Styles>
        <Style Selector="Border.rec">
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,0,0,19" />
            <Setter Property="Margin" Value="0,0,0,19" />
        </Style>
        <!-- A mark must not change the row's height: extent growth reads as new content and triggers ScrollToEnd. -->
        <Style Selector="Border.rec.jump">
            <Setter Property="Background" Value="{StaticResource Paper}" />
            <Setter Property="Padding" Value="12,9,12,19" />
            <Setter Property="Margin" Value="-12,0,-12,19" />
        </Style>
        <Style Selector="Border.rec TextBlock.body">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="LineHeight" Value="28" />
        </Style>
        <Style Selector="TextBlock.body.partial, TextBlock.body.pending">
            <Setter Property="Foreground" Value="{StaticResource Ink3}" />
        </Style>
        <Style Selector="Panel.focused Border.rec TextBlock.body">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="LineHeight" Value="33" />
        </Style>
        <Style Selector="Panel.focused ItemsControl.bubbles">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="MaxWidth" Value="780" />
        </Style>
        <Style Selector="Border.rec TextBlock.who"><Setter Property="FontSize" Value="11" /></Style>
        <Style Selector="Border.rename">
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.rename:pointerover, Border.rename:focus">
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
        </Style>
        <Style Selector="TextBox#MeetingTitleEditor /template/ Border#PART_BorderElement">
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="TextBox#MeetingTitleEditor:pointerover /template/ Border#PART_BorderElement, TextBox#MeetingTitleEditor:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
        </Style>
        <Style Selector="Border.colhead">
            <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
            <Setter Property="BorderThickness" Value="0,2,0,0" />
        </Style>
        <Style Selector="Border.colhead:focus">
            <Setter Property="Background" Value="{StaticResource BrandWash}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand}" />
        </Style>
        <Style Selector="Border.tickrow">
            <Setter Property="Height" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Rectangle.tick">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="2" />
        </Style>
        <Style Selector="Rectangle.tick.current">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="3" />
        </Style>
        <Style Selector="Border.tickrow:pointerover Rectangle.tick">
            <Setter Property="Width" Value="20" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <Border DockPanel.Dock="Top" x:Name="RecordingBanner"
                IsVisible="{Binding ShowRecordingBanner}"
                Background="{StaticResource Paper}"
                BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1"
                Padding="28,9">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                         Fill="{StaticResource Record}" />
                <TextBlock x:Name="RecordingBannerText" Text="{Binding RecordingBannerText}"
                           FontSize="12.5" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource Ink2}" />
                <TextBlock Text="·" FontSize="12.5" VerticalAlignment="Center"
                           Foreground="{StaticResource Ink3}" />
                <Button x:Name="ReturnToActive" Classes="ghost" Padding="0"
                        Command="{Binding ReturnToActiveMeetingCommand}"
                        AutomationProperties.Name="{l:T browse.return}">
                    <TextBlock Text="{l:T browse.return}" FontSize="12.5" FontWeight="SemiBold"
                               TextDecorations="Underline" Foreground="{StaticResource Ink}" />
                </Button>
            </StackPanel>
        </Border>

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="28,24,28,22" ColumnSpacing="16">
            <DockPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="ReadOnlyNote" DockPanel.Dock="Right" Margin="12,0,0,0" Classes="label"
                           Text="{l:T browse.readonly}" IsVisible="{Binding IsTitleReadOnly}" />

                <TextBlock x:Name="TitleNote" DockPanel.Dock="Right" Margin="12,0,0,0" Text="{Binding TitleNote}"
                           IsVisible="{Binding HasTitleNote}"
                           FontSize="12" VerticalAlignment="Center"
                           Foreground="{StaticResource Ink3}" />

                <Border x:Name="MeetingTitleField" Classes="rename" Background="Transparent"
                        HorizontalAlignment="Left" Focusable="True" Cursor="Ibeam"
                        IsEnabled="{Binding !IsTitleReadOnly}"
                        IsVisible="{Binding !IsRenamingTitle}"
                        PointerPressed="OnTitlePressed" KeyDown="OnTitleKeyDown"
                        ToolTip.Tip="{l:T title.rename.tip}"
                        AutomationProperties.Name="{l:T title.rename.tip}">
                    <TextBlock x:Name="MeetingTitle" Text="{Binding MeetingTitle}"
                               FontSize="25" LineHeight="32" FontWeight="SemiBold" LetterSpacing="-0.4"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Foreground="{StaticResource Ink}" />
                </Border>
            </DockPanel>

            <!-- Selection foreground is explicit so the title stays readable inside the brand fill. -->
            <TextBox Grid.Column="0" x:Name="MeetingTitleEditor" Text="{Binding TitleDraft}"
                     IsVisible="{Binding IsRenamingTitle}"
                     HorizontalAlignment="Left" VerticalAlignment="Center"
                     MinWidth="120" MinHeight="0" VerticalContentAlignment="Center"
                     FontSize="25" LineHeight="32" FontWeight="SemiBold" LetterSpacing="-0.4"
                     Padding="0" BorderThickness="0,0,0,2"
                     BorderBrush="{StaticResource Ink}"
                     SelectionBrush="{StaticResource Brand}" SelectionForegroundBrush="{StaticResource OnBrand}"
                     Background="Transparent" Foreground="{StaticResource Ink}"
                     KeyDown="OnTitleEditorKeyDown" LostFocus="OnTitleEditorLostFocus"
                     AutomationProperties.Name="{l:T title.rename.tip}" />

            <Button Grid.Column="1" x:Name="RegenerateTitle" Classes="ghost icon compact"
                    IsVisible="{Binding CanNameMeeting}"
                    Command="{Binding RegenerateTitleCommand}"
                    ToolTip.Tip="{l:T title.regenerate.tip}"
                    AutomationProperties.Name="{l:T title.regenerate.tip}">
                <Path Classes="glyph" Data="{c:Icon regenerate}" Width="15" Height="15" />
            </Button>

            <Button Grid.Column="2" x:Name="RoomLanguages" Classes="ghost" Padding="6,4"
                    HorizontalAlignment="Right" Click="OnLanguagesClick"
                    IsEnabled="{Binding !IsRunning}"
                    ToolTip.Tip="{l:T languages.tip}"
                    AutomationProperties.Name="{l:T languages.tip}">
                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding SelectedLanguages}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="-8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LanguageOption">
                                <Border Background="{StaticResource Sheet}" CornerRadius="13" Padding="2">
                                    <c:FlagIcon Code="{Binding Code}" Width="22" Height="22" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding SelectedLanguageSummary}" FontSize="12"
                               Foreground="{StaticResource Ink2}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <Panel>
        <StackPanel x:Name="NoStoredTranscript" IsVisible="{Binding ShowNoStoredTranscript}"
                    Margin="28,8,28,10" MaxWidth="440"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Spacing="14">
            <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" />
            <TextBlock TextWrapping="Wrap" FontSize="14.5" LineHeight="25"
                       Foreground="{StaticResource Ink2}" Text="{l:T browse.notranscript}" />
        </StackPanel>

        <StackPanel IsVisible="{Binding ShowStartHint}" Margin="28,8,28,10" MaxWidth="440"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Spacing="14">
            <Image Source="/Assets/kanal-splash-mark.png" Width="92" Height="92"
                   HorizontalAlignment="Left" Margin="-18,0,0,0" AutomationProperties.Name="Kanal" />
            <TextBlock Text="{l:T empty.heading}" Classes="label" />
            <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" />
            <TextBlock TextWrapping="Wrap" FontSize="14.5" LineHeight="25"
                       Foreground="{StaticResource Ink2}" Text="{l:T empty.body1}" />
            <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="21"
                       Foreground="{StaticResource Ink3}" Text="{l:T empty.body2}" />
        </StackPanel>

        <Grid ColumnDefinitions="*,Auto">
        <ItemsControl Grid.Column="0" ItemsSource="{Binding ShownColumns}" Margin="16,0,0,10" Padding="12,0,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerTheme>
                <ControlTheme TargetType="ContentPresenter" x:DataType="vm:ColumnViewModel">
                    <Setter Property="IsVisible" Value="{Binding IsShown}" />
                </ControlTheme>
            </ItemsControl.ItemContainerTheme>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ColumnViewModel">
                    <Panel Margin="0,0,27,0" Classes.focused="{Binding IsFocused}" DragDrop.AllowDrop="True"
                           DragDrop.DragOver="OnColumnDragOver"
                           DragDrop.DragLeave="OnColumnDragLeave"
                           DragDrop.Drop="OnColumnDrop">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Classes="colhead" Margin="0,0,0,22"
                                    Background="Transparent" Focusable="True" Cursor="SizeWestEast"
                                    ToolTip.Tip="{l:T column.drag.tip}"
                                    PointerPressed="OnColumnHeadPointerPressed" KeyDown="OnColumnHeadKeyDown">
                                <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1"
                                        Padding="0,9,0,8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Code}" FontSize="24" LineHeight="30"
                                                       FontWeight="Bold" LetterSpacing="-0.6" />
                                            <TextBlock Grid.Column="1" Text="{Binding NativeName}" FontSize="11.5"
                                                       Foreground="{StaticResource Ink2}"
                                                       VerticalAlignment="Bottom" Margin="9,0,4,5"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <Button Grid.Column="1" x:Name="ColumnFocus" Classes="ghost icon compact"
                                                IsVisible="{Binding CanFocus}"
                                                Click="OnColumnFocusClick"
                                                ToolTip.Tip="{l:T column.focus.tip}"
                                                AutomationProperties.Name="{l:T column.focus.tip}">
                                            <Path Classes="glyph" Data="{c:Icon expand}" Width="16" Height="16"
                                                  IsVisible="{Binding !IsFocused}" />
                                        </Button>
                                        <Button Grid.Column="1" x:Name="ColumnRestore" Classes="ghost icon compact"
                                                IsVisible="{Binding IsFocused}"
                                                Click="OnColumnFocusClick"
                                                ToolTip.Tip="{l:T column.restore.tip}"
                                                AutomationProperties.Name="{l:T column.restore.tip}">
                                            <Path Classes="glyph" Data="{c:Icon restore}" Width="16" Height="16" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </Border>
                            <ScrollViewer Loaded="OnColumnScrollLoaded" Margin="-12,0,-12,0"
                                          DetachedFromVisualTree="OnColumnScrollDetached">
                                <ItemsControl Classes="bubbles" ItemsSource="{Binding Bubbles}" Margin="12,0,26,40" ClipToBounds="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BubbleViewModel">
                                            <Border Classes="rec" Classes.jump="{Binding IsJumpTarget}">
                                                <StackPanel Spacing="5">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Classes="who" Text="{Binding SpeakerName}"
                                                                   FontWeight="Bold" LetterSpacing="1.2"
                                                                   Foreground="{Binding SpeakerColor}" />
                                                        <TextBlock Classes="who" Text="{Binding SourceLang}"
                                                                   LetterSpacing="1.5" Foreground="{StaticResource Ink3}" />
                                                        <TextBlock Classes="who" Text="{l:T column.original}"
                                                                   LetterSpacing="1.5" IsVisible="{Binding IsTranscript}"
                                                                   ToolTip.Tip="{l:T column.original.tip}"
                                                                   Foreground="{StaticResource Ink3}" />
                                                        <TextBlock Classes="who" Text="⇄"
                                                                   ToolTip.Tip="{l:T column.codeswitch.tip}"
                                                                   IsVisible="{Binding CodeSwitch}"
                                                                   Foreground="{StaticResource Ink3}" />
                                                    </StackPanel>
                                                    <TextBlock Classes="body" Text="{Binding Text}" TextWrapping="Wrap"
                                                               Classes.partial="{Binding IsPartial}"
                                                               Classes.pending="{Binding AwaitingTranslation}" />
                                                    <Border IsVisible="{Binding HasSource}" Margin="0,4,0,0"
                                                            BorderBrush="{StaticResource Rule}"
                                                            BorderThickness="2,0,0,0" Padding="11,0,0,0">
                                                        <TextBlock Text="{Binding SourceText}" TextWrapping="Wrap"
                                                                   FontSize="12.5" LineHeight="22"
                                                                   Foreground="{StaticResource Ink3}" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                        <Rectangle Width="3" HorizontalAlignment="Left" Margin="-16,0,0,0"
                                   Fill="{StaticResource Ink}" IsVisible="{Binding IsDropBefore}" />
                        <Rectangle Width="3" HorizontalAlignment="Right" Margin="0,0,-16,0"
                                   Fill="{StaticResource Ink}" IsVisible="{Binding IsDropAfter}" />
                    </Panel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl Grid.Column="1" ItemsSource="{Binding ShownRuler.Ticks}"
                      Width="30" Margin="0,2,12,10" VerticalAlignment="Top"
                      AutomationProperties.Name="{l:T ruler.name}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RulerTickViewModel">
                    <Border Classes="tickrow"
                            PointerEntered="OnTickEntered" PointerExited="OnTickExited"
                            PointerPressed="OnTickPressed"
                            AutomationProperties.Name="{Binding AccessibleName}">
                        <Rectangle Classes="tick" Classes.current="{Binding IsCurrent}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Fill="{Binding SpeakerColor}" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Canvas Grid.Column="0" Grid.ColumnSpan="2" Margin="0,2,12,10" IsHitTestVisible="False"
                IsVisible="{Binding ShownRuler.IsPreviewOpen}">
            <ContentControl Canvas.Right="40" Canvas.Top="{Binding ShownRuler.PreviewTop}"
                            Content="{Binding ShownRuler.HoveredTick}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:RulerTickViewModel">
                        <Border Width="308" Height="96" CornerRadius="{StaticResource OverlayRadius}"
                                Background="{StaticResource Sheet}"
                                BorderBrush="{StaticResource Rule}" BorderThickness="1">
                            <Panel>
                                <StackPanel Margin="15,11" Spacing="7">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <TextBlock Text="{Binding SpeakerName}" FontSize="10.5"
                                                   FontWeight="Bold" LetterSpacing="1.2" MaxWidth="176"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding SpeakerColor}" />
                                        <TextBlock Text="{Binding TimeLabel}" FontSize="10.5"
                                                   LetterSpacing="1.5"
                                                   Foreground="{StaticResource Ink3}" />
                                        <TextBlock Text="{Binding FoldBadge}" FontSize="10.5"
                                                   LetterSpacing="1.5"
                                                   Foreground="{StaticResource Ink3}" />
                                    </StackPanel>
                                    <Border BorderBrush="{StaticResource RuleFaint}"
                                            BorderThickness="0,0,0,1" />
                                    <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" MaxLines="2"
                                               TextTrimming="CharacterEllipsis" FontSize="12.5"
                                               LineHeight="20" Foreground="{StaticResource Ink2}" />
                                </StackPanel>
                                <Rectangle Width="3" HorizontalAlignment="Right"
                                           Fill="{StaticResource Ink}" />
                            </Panel>
                        </Border>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Canvas>
        </Grid>
        </Panel>
    </DockPanel>
</UserControl>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kanal.Host.ViewModels"
        xmlns:controls="using:Kanal.Host.Controls"
        xmlns:l="using:Kanal.Host.Localization"
        x:Class="Kanal.Host.Views.LanguagesWindow"
        x:DataType="vm:MainViewModel"
        Title="{l:T langdlg.title}"
        Width="400" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource Sans}"
        TextElement.Foreground="{StaticResource Ink}"
        Background="{StaticResource Sheet}">

    <StackPanel Margin="26,20,26,18" Spacing="0">
        <TextBlock Text="{l:T langdlg.heading}" Classes="label" />
        <Border BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,2" Margin="0,7,0,2" />

        <ItemsControl ItemsSource="{Binding LanguageOptions}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LanguageOption">
                    <!-- The row is 42 px of content over a hairline, but that height belongs to
                         the row, not to the checkbox: Fluent pins the tick box to the top of
                         whatever height the checkbox is given, so stretching the checkbox to 42
                         left the box five pixels above the flag and the name it belongs to, on
                         every row alike. At its natural height, centred in the row, the box and
                         its label share one centre line.

                         That natural height is the tick grid's fixed 32, so this holds while the
                         row's content stays 32 px or shorter - a taller flag would push the
                         checkbox past the box and reopen the gap, with a green build and, per
                         CLAUDE.md, no layout test to catch it. -->
                    <Border BorderBrush="{StaticResource RuleFaint}" BorderThickness="0,0,0,1"
                            MinHeight="43" Opacity="{Binding RowOpacity}">
                        <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsSelectable}"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                  Padding="10,0,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                                <controls:FlagIcon Code="{Binding Code}" Width="24" Height="24" />
                                <TextBlock Text="{Binding CodeUpper}" FontWeight="Bold" LetterSpacing="1"
                                           FontSize="12.5" VerticalAlignment="Center" Width="30" />
                                <TextBlock Text="{Binding Label}" FontSize="12.5"
                                           Foreground="{StaticResource Ink2}" VerticalAlignment="Center" />
                            </StackPanel>
                        </CheckBox>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- The cap, stated where it bites: the rows above are disabled and Add refuses. -->
        <TextBlock Text="{Binding LanguageLimitNotice}" IsVisible="{Binding IsAtLanguageLimit}"
                   Margin="0,13,0,0" TextWrapping="Wrap" FontSize="11.5" LineHeight="18"
                   Foreground="{StaticResource Ink2}" />

        <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,0">
            <TextBox Grid.Column="0" Text="{Binding NewLanguageInput}" PlaceholderText="{l:T langdlg.placeholder}"
                     Margin="0,0,8,0">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding AddLanguageCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="1" Content="{l:T langdlg.add}" Command="{Binding AddLanguageCommand}"
                    IsEnabled="{Binding !IsAtLanguageLimit}" />
        </Grid>

        <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" FontSize="11.5" LineHeight="18"
                   Foreground="{StaticResource Ink3}"
                   Text="{l:T langdlg.note}" />

        <Button Content="{l:T langdlg.done}" Classes="accent" HorizontalAlignment="Right" Margin="0,16,0,0"
                Click="OnDoneClick" />
    </StackPanel>
</Window>

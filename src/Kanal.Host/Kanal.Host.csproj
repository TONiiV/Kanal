<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- The version the About section shows and CHANGELOG.md's newest entry names. A test holds
         the two together, so releasing is: add the changelog entry, bump this. -->
    <Version>1.0.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Embeds the icon in the exe's Win32 resources. MainWindow.axaml only sets
         the window icon, which Explorer, pinned shortcuts and Alt-Tab never read.
         Ignored by non-Windows builds, so it needs no OS condition. -->
    <ApplicationIcon>Assets\kanal.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <EmbeddedResource Include="Localization\i18n\*.json" />
    <!-- The repository's own changelog, shown in the application: one file, so the version an
         operator reads on screen cannot drift from the one a reader sees on GitHub. -->
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="Kanal.Host.CHANGELOG.md" />
    <Content Include="Info.plist" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="NLog" Version="6.1.4" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kanal.Core\Kanal.Core.csproj" />
    <ProjectReference Include="..\Kanal.Audio\Kanal.Audio.csproj" />
    <ProjectReference Include="..\Kanal.Providers.Gladia\Kanal.Providers.Gladia.csproj" />
    <ProjectReference Include="..\Kanal.Providers.LocalMt\Kanal.Providers.LocalMt.csproj" />
  </ItemGroup>

  <!-- macOS reads privacy purpose strings from Contents/Info.plist, never from a file placed
       beside a raw Mach-O. Keep a runnable development bundle in every macOS build so the same
       artifact that requests TCC permission is the one whose declarations are tested. -->
  <Target Name="CreateMacAppBundle"
          AfterTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PropertyGroup>
      <_MacAppDir>$(TargetDir)Kanal.app/Contents</_MacAppDir>
    </PropertyGroup>
    <ItemGroup>
      <_MacHostFile Include="$(TargetDir)*"
                    Exclude="$(TargetDir)Info.plist" />
    </ItemGroup>
    <MakeDir Directories="$(_MacAppDir)/MacOS" />
    <Copy SourceFiles="@(_MacHostFile)" DestinationFolder="$(_MacAppDir)/MacOS" SkipUnchangedFiles="true" />
    <Copy SourceFiles="Info.plist" DestinationFiles="$(_MacAppDir)/Info.plist" SkipUnchangedFiles="true" />
  </Target>
</Project>

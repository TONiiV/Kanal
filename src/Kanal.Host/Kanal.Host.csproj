<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- The version the About section shows and CHANGELOG.md's newest entry names. A test holds
         the two together, so releasing is: add the changelog entry, bump this. -->
    <Version>1.0.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Embeds the icon in the exe's Win32 resources. MainWindow.axaml only sets
         the window icon, which Explorer, pinned shortcuts and Alt-Tab never read.
         Ignored by non-Windows builds, so it needs no OS condition. -->
    <ApplicationIcon>Assets\kanal.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <EmbeddedResource Include="Localization\i18n\*.json" />
    <!-- The repository's own changelog, shown in the application: one file, so the version an
         operator reads on screen cannot drift from the one a reader sees on GitHub. -->
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="Kanal.Host.CHANGELOG.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="NLog" Version="6.1.4" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kanal.Core\Kanal.Core.csproj" />
    <ProjectReference Include="..\Kanal.Audio\Kanal.Audio.csproj" />
    <ProjectReference Include="..\Kanal.Providers.Gladia\Kanal.Providers.Gladia.csproj" />
    <ProjectReference Include="..\Kanal.Providers.LocalMt\Kanal.Providers.LocalMt.csproj" />
  </ItemGroup>

  <!-- macOS reads privacy purpose strings from Contents/Info.plist, never from one beside a raw
       Mach-O, so system-audio permission is unobtainable without a bundle. The declarations come
       from the installer's template rather than a copy: a second plist here would drift from the
       shipped one, and a permission the developer sees granted would be denied for the operator. -->
  <Target Name="CreateMacAppBundle"
          AfterTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PropertyGroup>
      <_MacAppDir>$(TargetDir)Kanal.app/Contents</_MacAppDir>
      <_MacPlistSource>$(MSBuildThisFileDirectory)../../installers/macos/</_MacPlistSource>
      <!-- Read as a property: item values split on semicolons, which would mangle the plist. -->
      <_MacPlist>$([System.IO.File]::ReadAllText('$(_MacPlistSource)Info.plist.template').Replace('__VERSION__', '$(Version)'))</_MacPlist>
    </PropertyGroup>
    <ItemGroup>
      <_MacHostFile Include="$(TargetDir)**/*" Exclude="$(TargetDir)Kanal.app/**/*" />
      <_MacPlistStrings Include="$(_MacPlistSource)lproj/*.strings" />
    </ItemGroup>
    <MakeDir Directories="$(_MacAppDir)/MacOS" />
    <Copy SourceFiles="@(_MacHostFile)"
          DestinationFiles="$(_MacAppDir)/MacOS/%(RecursiveDir)%(Filename)%(Extension)"
          SkipUnchangedFiles="true" />
    <WriteLinesToFile File="$(_MacAppDir)/Info.plist" Lines="$(_MacPlist)"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <Copy SourceFiles="@(_MacPlistStrings)"
          DestinationFiles="@(_MacPlistStrings->'$(_MacAppDir)/Resources/%(Filename).lproj/InfoPlist.strings')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>

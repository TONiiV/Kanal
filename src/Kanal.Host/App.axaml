<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Kanal.Host.App"
             xmlns:local="using:Kanal.Host"
             RequestedThemeVariant="Light">
    <!-- The window chrome is designed on a fixed light palette; following the OS
         dark theme made control foregrounds invisible on the light surfaces.
         Every colour below is therefore explicit — see .impeccable.md. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <!-- Ink and paper only. Colour is reserved for speaker identity. -->
            <SolidColorBrush x:Key="Sheet" Color="#FCFCFD" />
            <SolidColorBrush x:Key="Paper" Color="#F1F3F5" />
            <SolidColorBrush x:Key="Ink" Color="#111A21" />
            <SolidColorBrush x:Key="Ink2" Color="#4A5862" />
            <SolidColorBrush x:Key="Ink3" Color="#7C8A93" />
            <SolidColorBrush x:Key="Rule" Color="#D5DCE1" />
            <SolidColorBrush x:Key="RuleFaint" Color="#E7EBEE" />
            <SolidColorBrush x:Key="Alarm" Color="#8B2F2F" />
            <!-- Off the speaker palette on purpose: a transport mark must never read as a person. -->
            <SolidColorBrush x:Key="Record" Color="#C42B22" />
            <SolidColorBrush x:Key="Hold" Color="#C08A12" />
            <SolidColorBrush x:Key="RecordWash" Color="#F2CFCC" />
            <SolidColorBrush x:Key="HoldWash" Color="#F2E6C6" />

            <!-- FluentTheme paints checked boxes, radios and selection in the OS accent, which put a
                 saturated blue beside the speaker hues and out-shouted them. Redirect the accent ramp
                 onto the ink palette: hover and pressed states still differ, but by weight, not hue. -->
            <Color x:Key="SystemAccentColor">#111A21</Color>
            <Color x:Key="SystemAccentColorLight1">#4A5862</Color>
            <Color x:Key="SystemAccentColorLight2">#7C8A93</Color>
            <Color x:Key="SystemAccentColorLight3">#D5DCE1</Color>
            <Color x:Key="SystemAccentColorDark1">#111A21</Color>
            <Color x:Key="SystemAccentColorDark2">#111A21</Color>
            <Color x:Key="SystemAccentColorDark3">#111A21</Color>

            <!-- Latin first so Polish diacritics come from the grotesque, CJK from the fallback.
                 No embedded font: a Latin-only face would clash with the CJK fallback it sits next to. -->
            <FontFamily x:Key="Sans">Helvetica Neue, Helvetica, Segoe UI Variable Text, Segoe UI, Arial, Microsoft YaHei, PingFang SC</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Swiss editorial: square corners, hairline rules, type doing the work. -->

        <!-- Ink is set once per window via TextElement.Foreground and inherited from there.
             A global TextBlock.Foreground setter would out-rank the inherited value that
             filled controls hand their content, painting checked chips black on black. -->

        <!-- Tiny letterspaced caps used as form labels and section heads. -->
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{StaticResource Ink3}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1.6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.rule">
            <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Margin" Value="0,7,0,10" />
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="{StaticResource Sheet}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource Sheet}" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Ink2}" />
            <Setter Property="BorderBrush" Value="{StaticResource Ink2}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource Sheet}" />
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Sheet}" />
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource Ink3}" />
        </Style>

        <!-- The one filled control on screen: whatever starts the meeting. -->
        <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource Sheet}" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Ink2}" />
            <Setter Property="BorderBrush" Value="{StaticResource Ink2}" />
        </Style>
        <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Rule}" />
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource Sheet}" />
        </Style>

        <!-- A glyph is not text and does not inherit TextElement.Foreground, so every button
             state has to say what the icon is painted with. Stated explicitly for the same
             reason every other colour here is: an icon that stays ink on an ink hover fill
             disappears, and the transport row is the one thing the operator reaches for
             while a meeting is running. -->
        <!-- Declared before the button rules so those still win: a glyph outside a button - in a
             combo box's selection box, say - would otherwise draw with no brush at all. -->
        <!-- Square, and 16 to match the icons' own view box: an icon carries its margins inside
             that box, and a control box of another shape scales it to the smaller side and pins
             what is left to the top-left rather than centring it. -->
        <Style Selector="Path.glyph">
            <Setter Property="Fill" Value="{StaticResource Ink2}" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Button Path.glyph">
            <Setter Property="Fill" Value="{StaticResource Ink}" />
        </Style>
        <Style Selector="Button:pointerover Path.glyph">
            <Setter Property="Fill" Value="{StaticResource Sheet}" />
        </Style>
        <Style Selector="Button:pressed Path.glyph">
            <Setter Property="Fill" Value="{StaticResource Sheet}" />
        </Style>
        <Style Selector="Button:disabled Path.glyph">
            <Setter Property="Fill" Value="{StaticResource Ink3}" />
        </Style>
        <Style Selector="Button.accent Path.glyph">
            <Setter Property="Fill" Value="{StaticResource Sheet}" />
        </Style>
        <Style Selector="Button.accent:disabled Path.glyph">
            <Setter Property="Fill" Value="{StaticResource Sheet}" />
        </Style>
        <Style Selector="Button.ghost Path.glyph">
            <Setter Property="Fill" Value="{StaticResource Ink2}" />
        </Style>
        <Style Selector="Button.ghost:pointerover Path.glyph">
            <Setter Property="Fill" Value="{StaticResource Sheet}" />
        </Style>

        <Style Selector="Border.sidebar-header">
            <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Padding" Value="20,9,12,9" />
        </Style>

        <!-- Quiet secondary actions: no box until you reach for them. -->
        <Style Selector="Button.ghost">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Ink2}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <!-- Without this the base disabled rule draws the box a ghost never had. -->
        <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- Declared after Button.ghost so a mark keeps its own fill through hover and press. -->
        <Style Selector="Button.mark">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{StaticResource RecordWash}" />
        </Style>

        <Style Selector="Button.mark.hold">
            <Setter Property="Background" Value="{StaticResource HoldWash}" />
        </Style>

        <Style Selector="Button.mark /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{TemplateBinding Background}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- Restated for :disabled, which would otherwise fall through to the base rule and ring
             the disc in Rule grey. -->
        <Style Selector="Button.mark:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{TemplateBinding Background}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="Button.mark:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.mark:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Record}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="Button.mark.hold:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.mark.hold:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Hold}" />
        </Style>

        <!-- Even, so the 34 px disc has the same slack on both sides of it. -->
        <Style Selector="Button.mark Path">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>

        <Style Selector="Button.mark Path.record">
            <Setter Property="Fill" Value="{StaticResource Record}" />
        </Style>

        <Style Selector="Button.mark Path.hold">
            <Setter Property="Fill" Value="{StaticResource Hold}" />
        </Style>

        <Style Selector="Button.mark:pointerover Path, Button.mark:pressed Path">
            <Setter Property="Fill" Value="{StaticResource Sheet}" />
        </Style>

        <Style Selector="Button.mark:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>


        <Style Selector="ToggleButton">
            <Setter Property="Background" Value="{StaticResource Sheet}" />
            <Setter Property="Foreground" Value="{StaticResource Ink3}" />
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource Sheet}" />
        </Style>
        <Style Selector="ToggleButton:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Ink2}" />
            <Setter Property="BorderBrush" Value="{StaticResource Ink2}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource Sheet}" />
        </Style>
        <Style Selector="ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource Ink}" />
        </Style>

        <!-- Flyouts are sheets of paper with a rule round them, like everything else here —
             not the themed rounded card with a shadow that Fluent ships. -->
        <Style Selector="FlyoutPresenter">
            <Setter Property="Background" Value="{StaticResource Sheet}" />
            <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
            <!-- Fluent's defaults are narrower than a readable measure of body text and taller
                 than this window: content wider than MaxWidth is clipped, not wrapped, so the
                 first version of the mode help lost the right-hand third of every line. -->
            <Setter Property="MaxWidth" Value="500" />
            <Setter Property="MaxHeight" Value="700" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="{StaticResource Sheet}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBox /template/ Border#PART_BorderElement">
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{StaticResource Sheet}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- FluentTheme paints selection in the system accent; on this screen colour belongs
             to speakers alone, so selection is a paper block and square corners instead. -->
        <Style Selector="ComboBoxItem">
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Paper}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource Ink}" />
        </Style>
        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Rule}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource Ink}" />
        </Style>
        <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Rule}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource Ink}" />
        </Style>
        <!-- A mode that cannot run recedes in contrast, never in legibility: its reason is
             the whole reason the row is still in the list. -->
        <Style Selector="ComboBoxItem:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource Ink2}" />
        </Style>
    </Application.Styles>
</Application>

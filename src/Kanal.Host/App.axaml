<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Kanal.Host.App"
             xmlns:local="using:Kanal.Host"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             xmlns:vm="using:Kanal.Host.ViewModels"
             RequestedThemeVariant="Light">
    <!-- The window chrome is designed on a fixed light palette; following the OS
         dark theme made control foregrounds invisible on the light surfaces.
         Every colour below is therefore explicit — see .impeccable.md. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <!-- Brand controls and speaker identity use separate semantic resources. -->
            <SolidColorBrush x:Key="Sheet" Color="#FFFCF7" />
            <SolidColorBrush x:Key="Paper" Color="#F5F0E6" />
            <SolidColorBrush x:Key="Ink" Color="#252B3B" />
            <SolidColorBrush x:Key="Ink2" Color="#535969" />
            <SolidColorBrush x:Key="Ink3" Color="#686D79" />
            <SolidColorBrush x:Key="Rule" Color="#CEC9C0" />
            <SolidColorBrush x:Key="RuleFaint" Color="#E9E3D9" />
            <SolidColorBrush x:Key="Alarm" Color="#8B2F2F" />
            <SolidColorBrush x:Key="CloseHover" Color="#C42B1C" />
            <!-- Off the speaker palette on purpose: a transport mark must never read as a person. -->
            <SolidColorBrush x:Key="Record" Color="#C42B22" />
            <SolidColorBrush x:Key="Hold" Color="#C08A12" />
            <SolidColorBrush x:Key="RecordWash" Color="#F2CFCC" />
            <SolidColorBrush x:Key="HoldWash" Color="#F2E6C6" />

            <SolidColorBrush x:Key="Brand" Color="#414B83" />
            <SolidColorBrush x:Key="BrandHover" Color="#35406F" />
            <SolidColorBrush x:Key="BrandPressed" Color="#293359" />
            <SolidColorBrush x:Key="BrandWash" Color="#EBEDF6" />
            <SolidColorBrush x:Key="BrandAccent" Color="#EAA66A" />
            <SolidColorBrush x:Key="OnBrand" Color="#FFFFFF" />
            <CornerRadius x:Key="ControlRadius">8</CornerRadius>
            <CornerRadius x:Key="OverlayRadius">12</CornerRadius>

            <Color x:Key="SystemAccentColor">#414B83</Color>
            <Color x:Key="SystemAccentColorLight1">#535E96</Color>
            <Color x:Key="SystemAccentColorLight2">#6B75A8</Color>
            <Color x:Key="SystemAccentColorLight3">#EBEDF6</Color>
            <Color x:Key="SystemAccentColorDark1">#35406F</Color>
            <Color x:Key="SystemAccentColorDark2">#293359</Color>
            <Color x:Key="SystemAccentColorDark3">#252B3B</Color>

            <!-- Latin first so Polish diacritics come from the grotesque, CJK from the fallback.
                 No embedded font: a Latin-only face would clash with the CJK fallback it sits next to. -->
            <FontFamily x:Key="Sans">Helvetica Neue, Helvetica, Segoe UI Variable Text, Segoe UI, Arial, Microsoft YaHei, PingFang SC</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />


        <!-- Ink is set once per window via TextElement.Foreground and inherited from there.
             A global TextBlock.Foreground setter would out-rank the inherited value that
             filled controls hand their content, painting checked chips black on black. -->

        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{StaticResource Ink2}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="0.3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.rule">
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Margin" Value="0,7,0,10" />
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="{StaticResource Sheet}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button:not(.ghost):not(.mark)">
            <Setter Property="MinHeight" Value="36" />
        </Style>
        <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrandWash}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource Brand}" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrandWash}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource BrandPressed}" />
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Sheet}" />
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource Ink3}" />
        </Style>

        <!-- The one filled control on screen: whatever starts the meeting. -->
        <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brand}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource OnBrand}" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrandHover}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandHover}" />
        </Style>
        <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Rule}" />
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource Sheet}" />
        </Style>

        <!-- A glyph is not text and does not inherit TextElement.Foreground, so every button
             state has to say what the icon is painted with. Stated explicitly for the same
             reason every other colour here is: an icon that stays ink on an ink hover fill
             disappears, and the transport row is the one thing the operator reaches for
             while a meeting is running. -->
        <!-- Declared before the button rules so those still win: a glyph outside a button - in a
             combo box's selection box, say - would otherwise draw with no brush at all. -->
        <!-- Square, and 16 to match the icons' own view box: an icon carries its margins inside
             that box, and a control box of another shape scales it to the smaller side and pins
             what is left to the top-left rather than centring it. -->
        <Style Selector="Path.glyph">
            <Setter Property="Fill" Value="{StaticResource Ink2}" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Styled rather than set on the Path: a local value beats a style, so an inline fill
             would keep a mode that cannot be picked at full ink while its row greys around it. -->
        <Style Selector="ComboBoxItem Path.mode">
            <Setter Property="Fill" Value="{StaticResource Ink}" />
        </Style>
        <Style Selector="ComboBoxItem:disabled Path.mode">
            <Setter Property="Fill" Value="{StaticResource Ink3}" />
        </Style>

        <Style Selector="Button Path.glyph">
            <Setter Property="Fill" Value="{StaticResource Ink}" />
        </Style>
        <Style Selector="Button:pointerover Path.glyph">
            <Setter Property="Fill" Value="{StaticResource Brand}" />
        </Style>
        <Style Selector="Button:pressed Path.glyph">
            <Setter Property="Fill" Value="{StaticResource BrandPressed}" />
        </Style>
        <Style Selector="Button:disabled Path.glyph">
            <Setter Property="Fill" Value="{StaticResource Ink3}" />
        </Style>
        <Style Selector="Button.accent Path.glyph">
            <Setter Property="Fill" Value="{StaticResource OnBrand}" />
        </Style>
        <Style Selector="Button.accent:disabled Path.glyph">
            <Setter Property="Fill" Value="{StaticResource Sheet}" />
        </Style>
        <Style Selector="Button.ghost Path.glyph">
            <Setter Property="Fill" Value="{StaticResource Ink2}" />
        </Style>
        <Style Selector="Button.ghost:pointerover Path.glyph">
            <Setter Property="Fill" Value="{StaticResource Brand}" />
        </Style>

        <Style Selector="Border.chrome-head">
            <Setter Property="Height" Value="58" />
            <Setter Property="Background" Value="{StaticResource Paper}" />
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="chrome:WindowDecorationProperties.ElementRole" Value="TitleBar" />
        </Style>
        <!-- Carries the header band across the splitter columns so the top row has no seam. -->
        <Style Selector="GridSplitter.shell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid RowDefinitions="Auto,*" Background="Transparent">
                        <Border Height="{x:Static vm:WorkspaceShellViewModel.HeaderHeight}"
                                Background="{StaticResource Paper}"
                                BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- The drawn caption overlay brings a title that would sit on the sidebar toggle and a
             fullscreen button; the header carries the brand and keeps minimise/maximise/close. -->
        <Style Selector="Button#PART_FullScreenButton">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Panel#PART_TitleTextPanel TextBlock">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button#PART_MinimizeButton, Button#PART_MaximizeButton, Button#PART_CloseButton">
            <Setter Property="Height" Value="{x:Static vm:WorkspaceShellViewModel.HeaderHeight}" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button#PART_MinimizeButton:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button#PART_MaximizeButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrandWash}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource Brand}" />
        </Style>
        <Style Selector="Button#PART_CloseButton:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button#PART_CloseButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource CloseHover}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="TextElement.Foreground" Value="White" />
        </Style>
        <Style Selector="Button#PART_MinimizeButton:pointerover, Button#PART_MaximizeButton:pointerover">
            <Setter Property="Foreground" Value="{StaticResource Brand}" />
        </Style>
        <Style Selector="Button#PART_MinimizeButton:pointerover Path, Button#PART_MaximizeButton:pointerover Path">
            <Setter Property="Fill" Value="{StaticResource Brand}" />
        </Style>
        <Style Selector="Button#PART_CloseButton:pointerover, Button#PART_CloseButton:pressed">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button#PART_CloseButton:pointerover Path, Button#PART_CloseButton:pressed Path">
            <Setter Property="Fill" Value="White" />
        </Style>
        <Style Selector="Border.chrome-head Button, Border.chrome-head ComboBox">
            <Setter Property="chrome:WindowDecorationProperties.ElementRole" Value="User" />
        </Style>

        <!-- 36 DIP hit area, transparent until reached for. -->
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.icon.compact">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
        </Style>

        <!-- Quiet secondary actions: no box until you reach for them. -->
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Ink2}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <!-- Without this the base disabled rule draws the box a ghost never had. -->
        <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- Declared after Button.ghost so a mark keeps its own fill through hover and press. -->
        <Style Selector="Button.mark">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{StaticResource RecordWash}" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="0:0:0.14" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.mark.hold">
            <Setter Property="Background" Value="{StaticResource HoldWash}" />
        </Style>

        <Style Selector="Button.mark /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{TemplateBinding Background}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- Restated for :disabled, which would otherwise fall through to the base rule and ring
             the disc in Rule grey. -->
        <Style Selector="Button.mark:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{TemplateBinding Background}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- Restated for the same reason as :disabled: a pseudo-class rule that activates later
             beats the plain one, so without these the base button's hover ink floods the disc. -->
        <Style Selector="Button.mark:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{TemplateBinding Background}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="Button.mark:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{TemplateBinding Background}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- Reaching for a mark grows it; it does not recolour it. Transport hues communicate recording state, so they remain stable on hover.
             Pressed repeats the hover scale so the theme's own press shrink cannot take over. -->
        <Style Selector="Button.mark:pointerover, Button.mark:pressed">
            <Setter Property="RenderTransform" Value="scale(1.1)" />
        </Style>

        <!-- Even, so the 34 px disc has the same slack on both sides of it. -->
        <Style Selector="Button.mark Path">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>

        <!-- The disc takes the button's whole box and is shrunk by a render transform instead of
             being laid out 3 px inside it. Laid out, that inset is 4.5 device pixels at 1.5x
             scaling, which layout rounding snaps to 4 and leaves the red circle half a pixel up
             and left of the centre of the wash. Render transforms are not rounded, so the two
             circles stay concentric at every scaling. 0.8235 is 28/34 — enough slack that the
             wash reads as a ring rather than a field. -->
        <Style Selector="Button.mark Path.disc">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform" Value="scale(0.8235)" />
        </Style>

        <Style Selector="Button.mark Path.record">
            <Setter Property="Fill" Value="{StaticResource Record}" />
        </Style>

        <Style Selector="Button.mark Path.hold">
            <Setter Property="Fill" Value="{StaticResource Hold}" />
        </Style>

        <Style Selector="Button.mark Arc.spinner">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="SweepAngle" Value="100" />
            <Setter Property="Stroke" Value="{StaticResource Record}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
        </Style>

        <Style Selector="Button.mark Arc.spinner[IsVisible=True]">
            <Style.Animations>
                <Animation Duration="0:0:0.9" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Button.mark:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <Style Selector="Window.reduce-motion Button.mark">
            <Setter Property="Transitions" Value="{x:Null}" />
        </Style>
        <Style Selector="Window.reduce-motion Button.mark:pointerover, Window.reduce-motion Button.mark:pressed">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Window.reduce-motion Button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions" Value="{x:Null}" />
        </Style>


        <Style Selector="ToggleButton">
            <Setter Property="Background" Value="{StaticResource Sheet}" />
            <Setter Property="Foreground" Value="{StaticResource Ink3}" />
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brand}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource OnBrand}" />
        </Style>
        <Style Selector="ToggleButton:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrandHover}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandHover}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource OnBrand}" />
        </Style>
        <Style Selector="ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource Brand}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource Brand}" />
        </Style>

        <Style Selector="FlyoutPresenter">
            <Setter Property="Background" Value="{StaticResource Sheet}" />
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayRadius}" />
            <Setter Property="Padding" Value="0" />
            <!-- Fluent's defaults are narrower than a readable measure of body text and taller
                 than this window: content wider than MaxWidth is clipped, not wrapped, so the
                 first version of the mode help lost the right-hand third of every line. -->
            <Setter Property="MaxWidth" Value="500" />
            <Setter Property="MaxHeight" Value="700" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="SelectionBrush" Value="{StaticResource Brand}" />
            <Setter Property="SelectionForegroundBrush" Value="{StaticResource OnBrand}" />
            <Setter Property="Background" Value="{StaticResource Sheet}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBox /template/ Border#PART_BorderElement">
            <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{StaticResource Sheet}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="ComboBox /template/ Border#PopupBorder">
            <Setter Property="Background" Value="{StaticResource Sheet}" />
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayRadius}" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
        </Style>
        <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Paper}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource Ink}" />
        </Style>
        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrandWash}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource Ink}" />
        </Style>
        <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrandWash}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource Ink}" />
        </Style>
        <!-- A mode that cannot run recedes in contrast, never in legibility: its reason is
             the whole reason the row is still in the list. -->
        <Style Selector="ComboBoxItem:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource Ink2}" />
        </Style>
        <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrandPressed}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandPressed}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource OnBrand}" />
        </Style>
        <Style Selector="Button.accent:pointerover Path.glyph, Button.accent:pressed Path.glyph">
            <Setter Property="Fill" Value="{StaticResource OnBrand}" />
        </Style>
        <Style Selector="Button.ghost:pressed Path.glyph">
            <Setter Property="Fill" Value="{StaticResource BrandPressed}" />
        </Style>
        <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource Brand}" />
        </Style>
        <Style Selector="ToggleButton:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrandHover}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource OnBrand}" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{StaticResource Brand}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{StaticResource Brand}" />
        </Style>
        <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="TextBox.search">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Background" Value="{StaticResource Sheet}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.search /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand}" />
        </Style>
        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="Background" Value="{StaticResource Sheet}" />
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayRadius}" />
        </Style>
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="{StaticResource Ink}" />
            <Setter Property="Foreground" Value="{StaticResource OnBrand}" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource Brand}" />
            <Setter Property="Background" Value="{StaticResource RuleFaint}" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
    </Application.Styles>
</Application>

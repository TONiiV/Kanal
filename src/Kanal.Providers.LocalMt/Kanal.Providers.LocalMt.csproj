<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Kanal.Core\Kanal.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- In-process llama.cpp bindings. Backend.Cpu covers Windows/Linux/mac CPU
         plus Metal GPU on mac; swap in LLamaSharp.Backend.Cuda12 for NVIDIA. -->
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kanal.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kanal.Audio\Kanal.Audio.csproj" />
    <ProjectReference Include="..\..\src\Kanal.Providers.LocalAsr\Kanal.Providers.LocalAsr.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kanal.Core.UnitTests" />
  </ItemGroup>

  <!-- The NuGet runtime is CPU only. -p:SherpaNative=<folder> replaces it with a GPU build of the same version. -->
  <Target Name="CopySherpaNative" AfterTargets="Build" Condition="'$(SherpaNative)' != ''">
    <ItemGroup>
      <SherpaNativeFile Include="$(SherpaNative)/*.dll;$(SherpaNative)/*.dylib;$(SherpaNative)/*.so*" />
    </ItemGroup>
    <Copy SourceFiles="@(SherpaNativeFile)" DestinationFolder="$(OutDir)runtimes/$(NETCoreSdkRuntimeIdentifier)/native" />
  </Target>

</Project>
